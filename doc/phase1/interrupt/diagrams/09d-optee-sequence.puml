@startuml
' Source: ../apollo-interrupt-architecture.drawio (page 09d-optee-sequence)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "GIC / CPU" as p0
participant "Native IRQ / GIC\ndriver" as p1
participant "Registered handler" as p2
participant "Peripheral" as p3

p0 -> p1 : 1. S-EL1 native IRQ entry
p1 -> p0 : 2. IAR1 read / INTID 확인
p1 -> p2 : 3. interrupt_call_handlers
p2 -> p3 : 4. status 처리 / source clear
p2 -> p1 : 5. handler 반환
p1 -> p0 : 6. EOIR1 → exception return

@enduml
