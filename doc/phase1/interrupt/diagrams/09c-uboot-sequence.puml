@startuml
' Source: ../apollo-interrupt-architecture.drawio (page 09c-uboot-sequence)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "Boot command" as p0
participant "Polling driver" as p1
participant "Peripheral / CPU" as p2
participant "Exception handler" as p3

p0 -> p1 : 1. I/O request
p1 -> p2 : 2. status 반복 read / timeout 확인
p1 -> p0 : 3. 완료 또는 오류 반환
p2 -> p3 : 4. 별도 경로: IRQ / FIQ exception
p3 -> p3 : 5. do_irq / do_fiq → register dump
p3 -> p3 : 6. panic: Resetting CPU

@enduml
