@startuml
' Source: ../apollo-interrupt-architecture.drawio (page 09b-tfa-sequence)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "Secure source / GIC" as p0
participant "CPU EL3 entry" as p1
participant "SPMD" as p2
participant "S-EL1 OP-TEE" as p3

p0 -> p1 : 1. NS 실행 중 G1S → FIQ
p1 -> p2 : 2. INTR_TYPE_S_EL1 handler
p2 -> p3 : 3. FFA_INTERRUPT / secure context 진입
p3 -> p0 : 4. IAR1 acknowledge / device 처리 / EOIR1
p3 -> p2 : 5. secure interrupt 처리 후 FF-A 복귀
p2 -> p1 : 6. NS context 복원

@enduml
