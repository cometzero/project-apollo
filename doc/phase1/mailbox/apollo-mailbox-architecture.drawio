        <mxCell id="ready" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;통신 준비 gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;VirtIO ring negotiation → 후속 kick에서 CL1 endpoint 생성 → 첫 RPMsg handshake로 ready&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#9A681E;" vertex="1">
          <mxGeometry as="geometry" x="48" y="591" width="1504" height="76" />
        </mxCell>
        <mxCell id="auto-line-8" parent="1" value="④ vring1 + packet buffer 작성 (AP → CL1)" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=block;endSize=8;strokeWidth=1.6;strokeColor=#235D86;fontColor=#235D86;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="194" y="724" />
            <mxPoint as="targetPoint" x="598" y="724" />
            <mxPoint as="offset" x="0" y="-18" />
          </mxGeometry>
        </mxCell>
        <mxCell id="auto-line-9" parent="1" value="⑤ vq1_tx: ch0 bit1 → CL1 INTID73" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=block;endSize=8;strokeWidth=1.6;strokeColor=#147B79;fontColor=#147B79;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="194" y="808" />
            <mxPoint as="targetPoint" x="1002" y="808" />
            <mxPoint as="offset" x="0" y="-18" />
          </mxGeometry>
        </mxCell>
        <mxCell id="notify" parent="1" value="&lt;b style=&quot;font-size:19px&quot;&gt;⑥ ISR callback → worker → OpenAMP notify&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:17px&quot;&gt;vring descriptor를 읽고 RPMsg endpoint로 packet 전달&lt;br&gt;MHU ISR에서 전체 network stack을 실행하지 않는다.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#147B79;" vertex="1">
          <mxGeometry as="geometry" x="836" y="852" width="716" height="100" />
        </mxCell>
        <mxCell id="auto-line-10" parent="1" value="⑦ 반환 packet: vring0 (CL1 → AP)" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=block;endSize=8;strokeWidth=1.6;strokeColor=#235D86;fontColor=#235D86;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1406" y="1007" />
            <mxPoint as="targetPoint" x="598" y="1007" />
            <mxPoint as="offset" x="0" y="-18" />
          </mxGeometry>
        </mxCell>
        <mxCell id="auto-line-11" parent="1" value="⑧ ch0 bit0 → AP INTID153 → rx callback" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=block;endSize=8;strokeWidth=1.6;strokeColor=#147B79;fontColor=#147B79;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1002" y="1090" />
            <mxPoint as="targetPoint" x="194" y="1090" />
            <mxPoint as="offset" x="0" y="-18" />
          </mxGeometry>
        </mxCell>
        <mxCell id="work" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;⑨ Linux workqueue가 virtqueue를 처리&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;arm_si_rproc_mb_callback → queue_work → rproc_vq_interrupt → RPMsg → rpmsg_netdev_cb → netif_rx&lt;br&gt;두 vring은 데이터 진행 상태를 보존한다. doorbell bit 자체에는 packet 수나 packet bytes가 없다.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
