        <mxCell id="kicker" parent="1" value="PROJECT APOLLO / MAILBOX ARCHITECTURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#235D86;fontStyle=1;" vertex="1">
