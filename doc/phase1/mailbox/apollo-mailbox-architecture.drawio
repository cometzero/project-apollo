        <mxCell id="zh" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;HIPC RX: OpenAMP / RPMsg → veth → network&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;resource table / RPMsg virtqueue / packet buffers&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#147B79;" vertex="1">
