        <mxCell id="zw" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;MHUv3 ISR → callback → work queue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;attach / detach / notify event 처리&lt;br&gt;IP packet 처리는 MHU register 밖에서 진행&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#147B79;" vertex="1">
          <mxGeometry as="geometry" x="78" y="448" width="660" height="100" />
        </mxCell>
