        <mxCell id="b1" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;DBE register 중심 / 기본 128, 일부 32 DBCH&lt;br&gt;FIFO·FastChannel engine 없음&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#9A681E;" vertex="1">
