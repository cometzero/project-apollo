        <mxCell id="sub" parent="1" value="128 DBCH 구성의 첫 batch: ch0=전체 길이, ch1..126=data word, ch127=notify. 후속 batch의 data는 ch0부터 시작한다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#52657A;fontStyle=0;" vertex="1">
