        <mxCell id="auto-line-1" parent="1" value="" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=none;endSize=8;strokeWidth=1.6;strokeColor=#BAC7D3;fontColor=#BAC7D3;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="48" y="1102" />
            <mxPoint as="targetPoint" x="1552" y="1102" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" parent="1" value="H1–H4 · 같은 주소와 driver를 사용하는 것은 호환성 근거다. timing / security / safety mechanism의 동등성 증거는 별도다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#235D86;fontStyle=0;" vertex="1">
