        <mxCell id="a1" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;DBE·FIFO·FastChannel·TZE 등은 구성별 기능&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
