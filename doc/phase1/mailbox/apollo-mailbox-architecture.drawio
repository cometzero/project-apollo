          <mxGeometry as="geometry" x="1485" y="23" width="65" height="30" />
        </mxCell>
        <mxCell id="title" parent="1" value="QEMU의 MMIO가 SystemC peer 상태와 IRQ로 이어진다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=34;fontColor=#172C43;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="48" y="67" width="1504" height="54" />
        </mxCell>
        <mxCell id="sub" parent="1" value="활성 backend는 SystemC mhu320ae이다. full profile의 protocol=doorbell-bridge는 메시지 의미를 firmware에 맡긴다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#52657A;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="127" width="1504" height="50" />
        </mxCell>
        <mxCell id="auto-line-1" parent="1" value="" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=none;endSize=8;strokeWidth=1.6;strokeColor=#BAC7D3;fontColor=#BAC7D3;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="48" y="1102" />
            <mxPoint as="targetPoint" x="1552" y="1102" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" parent="1" value="M1–M4 · full bridge는 delay 인자를 소비하지 않는다. 선택적 synthetic mode의 1000ns completion 설정을 HW latency로 인용하지 않는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#235D86;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="1117" width="1504" height="50" />
        </mxCell>
        <mxCell id="qa" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#BAC7D3;pointerEvents=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="214" width="350" height="680" />
        </mxCell>
        <mxCell id="qa-label" parent="1" value="송신 QEMU instance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontColor=#235D86;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="68" y="228" width="310" height="32" />
        </mxCell>
        <mxCell id="cpuA" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Guest CPU&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;payload 준비 → SET write&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
          <mxGeometry as="geometry" x="78" y="280" width="290" height="100" />
        </mxCell>
        <mxCell id="tlm" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;QemuInitiatorSocket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;iothread lock 해제&lt;br&gt;run_on_sysc&lt;br&gt;TLM attrs / requester ID&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
          <mxGeometry as="geometry" x="78" y="455" width="290" height="130" />
        </mxCell>
        <mxCell id="readback" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Guest 후속 처리&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;ACK / response 확인&lt;br&gt;IRQ 또는 polling&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#147B79;" vertex="1">
          <mxGeometry as="geometry" x="78" y="664" width="290" height="130" />
