@startuml
' Source: ../apollo-mailbox-architecture.drawio (page 13-hipc-sequence)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "Linux remoteproc" as p0
participant "MHU pair" as p1
participant "Zephyr veth / OpenAMP" as p2
participant "Shared SRAM" as p3

p0 -> p1 : 1. Attach / ch0 bit3
p1 -> p2 : 2. RX IRQ / deferred work
p2 -> p3 : 3. Publish resource table
p2 -> p0 : 4. Software ACK / ch0 bit2
p0 -> p2 : 5. VirtIO negotiation / RPMsg endpoint
p0 -> p3 : 6. Packet buffer / vring1 publish
p0 -> p1 : 7. Vring kick / ch0 bit1
p1 -> p2 : 8. RX callback → worker
p2 -> p3 : 9. Consume descriptor / payload

@enduml
