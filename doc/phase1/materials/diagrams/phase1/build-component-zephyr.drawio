        </mxCell>
        <mxCell id="note" value="Zephyr kernel, Arm Safety Island module, HSOC board는 서로 다른 소유 구역이다. HSOC sample이 기본 application으로 선택되는 것은 아니다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1;fontColor=#172C43;fontFamily=Arial;fontSize=17;spacing=12;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#53677E;">
