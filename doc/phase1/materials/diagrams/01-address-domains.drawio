        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rect_010" value="" style="shape=rectangle;rounded=0;absoluteArcSize=1;arcSize=0;fillColor=#f5f5f5;strokeColor=none;strokeWidth=1;" parent="1" vertex="1" connectable="0">
