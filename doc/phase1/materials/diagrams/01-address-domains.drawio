          <mxGeometry x="48" y="22.66666668" width="1208" height="48" as="geometry" />
        </mxCell>
        <mxCell id="text_012" value="52-bit system address의 [51:48]은 region selector, [47:0]은 region 내부 주소입니다." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily='Geist', 'Noto Sans KR', 'Noto Sans CJK KR', 'Apple SD Gothic Neo', 'Malgun Gothic', system-ui, sans-serif;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;" parent="1" vertex="1" connectable="0" sourceText="52-bit system address의 [51:48]은 region selector, [47:0]은 region 내부 주소입니다.">
