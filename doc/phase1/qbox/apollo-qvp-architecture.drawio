<mxfile host="app.diagrams.net" type="device" compressed="false" pages="11"><diagram id="01-modeling" name="01-modeling"><mxGraphModel page="0" background="#FFFFFF" adaptiveColors="0" grid="0" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="canvas" value="" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;pointerEvents=0;"><mxGeometry as="geometry" x="0" y="0" width="1600" height="1000" /></mxCell><mxCell id="kicker" value="PROJECT APOLLO  /  QVP ARCHITECTURE" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#235D86;fontStyle=1;"><mxGeometry as="geometry" x="48" y="26" width="1400" height="24" /></mxCell><mxCell id="page-number" value="01" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=right;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#52657A;fontStyle=1;"><mxGeometry as="geometry" x="1485" y="23" width="65" height="30" /></mxCell><mxCell id="title" value="Simulation과 Emulation — 서로 다른 관점의 결합" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=34;fontColor=#172C43;fontStyle=1;"><mxGeometry as="geometry" x="48" y="67" width="1504" height="54" /></mxCell><mxCell id="subtitle" value="Emulation은 소프트웨어가 보는 대상 동작을, Simulation은 모델의 상태와 사건 진행을 설명한다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#52657A;"><mxGeometry as="geometry" x="48" y="127" width="1504" height="44" /></mxCell><mxCell id="foot-line" edge="1" parent="1" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;endSize=9;strokeColor=#BAC7D3;strokeWidth=1.6;fontColor=#BAC7D3;fontFamily=Noto Sans CJK KR;fontSize=15;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="48" y="912" /><mxPoint as="targetPoint" x="1552" y="912" /></mxGeometry></mxCell><mxCell id="footer" value="QVP = QEMU의 ISA·장치 emulation + SystemC/TLM의 시스템 simulation. 어느 용어도 cycle accuracy를 자동 보장하지 않는다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#235D86;"><mxGeometry as="geometry" x="48" y="926" width="1504" height="52" /></mxCell><mxCell id="emu" value="" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAC7D3;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;pointerEvents=0;"><mxGeometry as="geometry" x="48" y="200" width="720" height="300" /></mxCell><mxCell id="emu-title" value="EMULATION  ·  대상 SW의 실행 계약" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=19;fontColor=#235D86;fontStyle=1;"><mxGeometry as="geometry" x="68" y="215" width="680" height="32" /></mxCell><mxCell id="guest" value="&lt;b style=&quot;font-size:20px&quot;&gt;실행 대상: Arm binary&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526