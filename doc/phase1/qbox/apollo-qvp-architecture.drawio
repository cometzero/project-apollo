canvas" value="" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;pointerEvents=0;"><mxGeometry as="geometry" x="0" y="0" width="1600" height="1000" /></mxCell><mxCell id="kicker" value="PROJECT APOLLO  /  QVP ARCHITECTURE" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#235D86;fontStyle=1;"><mxGeometry as="geometry" x="48" y="26" width="1400" height="24" /></mxCell><mxCell id="page-number" value="02" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=right;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#52657A;fontStyle=1;"><mxGeometry as="geometry" x="1485" y="23" width="65" height="30" /></mxCell><mxCell id="title" value="Arm Zena CSS FVP ↔ Apollo QVP" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=34;fontColor=#172C43;fontStyle=1;"><mxGeometry as="geometry" x="48" y="67" width="1504" height="54" /></mxCell><mxCell id="subtitle" value="비교 기준은 동일한 firmware domain과 SW-visible interface다. 두 플랫폼의 내부 구현과 시간 정책은 다르다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#52657A;"><mxGeometry as="geometry" x="48" y="127" width="1504" height="44" /></mxCell><mxCell id="foot-