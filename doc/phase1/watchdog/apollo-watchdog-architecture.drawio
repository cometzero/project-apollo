        <mxCell id="title" parent="1" value="Watchdog 출력과 실제 reset 범위는 다르다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=34;fontColor=#172C43;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="48" y="67" width="1504" height="54" />
        </mxCell>
        <mxCell id="sub" parent="1" value="같은 WS1이라도 AP NS는 firmware 경유, AP S는 reset controller 직결, SI/RSE는 현재 연결 경계가 다르다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#52657A;fontStyle=0;" vertex="1">
