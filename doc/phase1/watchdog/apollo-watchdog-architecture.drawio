          <mxGeometry as="geometry" x="1485" y="23" width="65" height="30" />
        </mxCell>
        <mxCell id="title" parent="1" value="SCP recovery: interrupt 문맥에서 reset 작업을 분리한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=34;fontColor=#172C43;fontStyle=1;" vertex="1">
          <mxGeometry as="geometry" x="48" y="67" width="1504" height="54" />
        </mxCell>
        <mxCell id="sub" parent="1" value="SCP가 OFF·reload·ON을 조정하고, RSE는 BL2 재검증·재적재 후 ACK한다. WS1 source는 AP cold-reset에서 clear된다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#52657A;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="127" width="1504" height="50" />
        </mxCell>
        <mxCell id="auto-line-1" parent="1" value="" style="html=1;whiteSpace=nowrap;edgeStyle=none;endArrow=none;endSize=8;strokeWidth=1.6;strokeColor=#BAC7D3;fontColor=#BAC7D3;fontFamily=Noto Sans CJK KR;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="48" y="1232" />
            <mxPoint as="targetPoint" x="1552" y="1232" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" parent="1" value="S1–S4 · P5–P7 · reset-clear→CPU release 순서를 코드에서 확인했다. 새 AP boot / SI·RSE 유지 / IRQ 재사용은 runtime 검증 대상이다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#235D86;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="1247" width="1504" height="50" />
        </mxCell>
        <mxCell id="isr" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;CL0 FIQ / ISR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;AP watchdog INTID321&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
