        </mxCell>
        <mxCell id="ns" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;AP NS WS1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;SI CL0 INTID321&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#147B79;" vertex="1">
          <mxGeometry as="geometry" x="72" y="280" width="295" height="100" />
        </mxCell>
        <mxCell id="scp" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;SCP deferred recovery&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;ISR에서 mask → event enqueue&lt;br&gt;framework에서 RSE / PPU 제어&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
