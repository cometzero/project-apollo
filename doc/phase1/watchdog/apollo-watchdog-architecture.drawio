            <mxPoint as="targetPoint" x="190.0" y="1190" />
          </mxGeometry>
        </mxCell>
        <mxCell id="event" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;SCP framework&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;recovery event / alarm&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#235D86;" vertex="1">
