          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="48" y="1032" />
            <mxPoint as="targetPoint" x="1552" y="1032" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" parent="1" value="P5–P7 · “AP cold-reset”은 QVP object / fanout 이름이다. silicon POR 범위나 전체 SoC 재부팅과 동등하다는 뜻은 아니다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#235D86;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="1047" width="1504" height="50" />
