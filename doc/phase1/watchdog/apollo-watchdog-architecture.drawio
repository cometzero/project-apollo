            <mxPoint as="targetPoint" x="1552" y="1032" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" parent="1" value="P5–P7 · “AP cold-reset”은 QVP object / fanout 이름이다. silicon POR 범위나 전체 SoC 재부팅과 동등하다는 뜻은 아니다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#235D86;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="1047" width="1504" height="50" />
        </mxCell>
        <mxCell id="top" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=#BAC7D3;pointerEvents=0;" vertex="1">
          <mxGeometry as="geometry" x="48" y="210" width="1504" height="490" />
        </mxCell>
        <mxCell id="top-label" parent="1" value="AP · 두 입력 경로가 AP cold-reset fanout에서 만난다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontColor=#235D86;fontStyle=1;" vertex="1">
