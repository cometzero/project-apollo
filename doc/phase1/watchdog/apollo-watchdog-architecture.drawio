        <mxCell id="canvas" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;" vertex="1">
          <mxGeometry as="geometry" x="0" y="0" width="1600" height="1320" />
        </mxCell>
        <mxCell id="kicker" parent="1" value="PROJECT APOLLO / WATCHDOG ARCHITECTURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#235D86;fontStyle=1;" vertex="1">
