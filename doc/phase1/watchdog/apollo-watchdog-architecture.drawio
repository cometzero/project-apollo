          <mxGeometry as="geometry" x="48" y="210" width="1504" height="490" />
        </mxCell>
        <mxCell id="top-label" parent="1" value="AP · 두 입력 경로가 AP cold-reset fanout에서 만난다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=1.5;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=12;fontColor=#172C43;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontColor=#235D86;fontStyle=1;" vertex="1">
