@startuml
' Source: ../apollo-watchdog-architecture.drawio (page 10d-tfm-sequence)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "Firmware caller" as p0
participant "arm_watchdog driver" as p1
participant "CMSDK Watchdog" as p2
participant "Interrupt / Reset" as p3

p0 -> p1 : 1. arm_watchdog_init(dev, timeout)
p1 -> p2 : 2. LOCK · driver timeout 저장 / disabled
p0 -> p1 : 3. arm_watchdog_unlock()
p1 -> p2 : 4. LOCK unlock key
p0 -> p1 : 5. arm_watchdog_enable()
p1 -> p2 : 6. LOAD=timeout · CTRL.INTEN / RESEN
p0 -> p1 : 7. arm_watchdog_feed() 반복
p1 -> p2 : 8. LOAD=timeout 재기록
p2 -> p3 : 9. 1차 만료 → interrupt (미처리 시 reset)
p0 -> p1 : 10. clear_interrupt_and_refresh_counter()
p1 -> p2 : 11. INTCLR write / interrupt clear · reload

@enduml
