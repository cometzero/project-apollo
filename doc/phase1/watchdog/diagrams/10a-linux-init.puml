@startuml
' Source: ../apollo-watchdog-architecture.drawio (page 10a-linux-init)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "DT / platform bus" as p0
participant "sbsa_gwdt probe" as p1
participant "Watchdog core" as p2
participant "Watchdog HW" as p3

p0 -> p1 : 1. arm,sbsa-gwdt match
p1 -> p3 : 2. map Control / Refresh · read IIDR / WCS
p1 -> p1 : 3. CNTFRQ → timeout conversion
p1 -> p3 : 4. WOR initialization
p1 -> p2 : 5. register watchdog_device / operations
p2 -> p2 : 6. /dev/watchdog* available

@enduml
