          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="48" y="1082" />
            <mxPoint as="targetPoint" x="1552" y="1082" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" value="Linux highres/NOHZ, RSE timer 시험, OP-TEE callout은 최종 build/runtime 조건을 확인해야 한다. 기본 문서 범위는 source/config 정적 추적이다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#235D86;">
