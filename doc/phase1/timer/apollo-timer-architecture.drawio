        <mxCell id="auto" value="&lt;b style=&quot;font-size:20px&quot;&gt;QEMU AIVAL rearm&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;만료 callback에서 현재 count + reload&lt;br&gt;지연 시 이전 deadline부터 catch-up하지 않음&lt;/font&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAC7D3;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;">
          <mxGeometry as="geometry" x="748" y="744" width="762" height="88" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b style=&quot;font-size:21px&quot;&gt;현재 모델에서 확인한 경계&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:18px&quot;&gt;disable은 IRQ를 낮추지만 예약 callback을 즉시 취소하지 않음 · AIVAL callback은 ENABLE 재검사 없이 rearm 가능&lt;br&gt;SSE timer reset은 timer_del/register clear만 수행하며 IRQ deassert 호출이 없음 — 실제 guest 영향은 미검증&lt;/font&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A681E;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;">
          <mxGeometry as="geometry" x="48" y="922" width="1504" height="139" />
        </mxCell>
      </root>
    </mxGraphModel>
