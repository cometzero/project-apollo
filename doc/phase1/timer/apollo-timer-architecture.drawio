        </mxCell>
        <mxCell id="subtitle" value="high-resolution timer 경로의 예다. 현재 arm64 driver는 counter+delta를 CVAL에 쓰며 timer PPI는 실행 EL에 따라 선택된다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#52657A;">
