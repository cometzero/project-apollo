      <mxCell id="eoi" value="EOImode1: ④ 직후 EOIR1(priority drop), ⑨ DIR(deactivate). EOImode0: ⑨ EOIR1로 둘 다 처리." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=21;strokeWidth=1.5;spacing=12;strokeColor=none;align=left;fontSize=17;spacing=0;">
        <mxGeometry as="geometry" x="48" y="1165" width="1500" height="30" />
      </mxCell>
      <mxCell id="note" value="Timer source 해소와 GIC 완료는 별개다. IMASK는 count/CVAL을 초기화하지 않으며, 다음 event 없으면 masked 상태를 유지한다." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=21;strokeWidth=1.5;spacing=12;strokeColor=none;align=left;fontSize=16;spacing=0;">
        <mxGeometry as="geometry" x="48" y="1210" width="1500" height="28" />
      </mxCell>
    </root>
  </mxGraphModel>
</diagram>
