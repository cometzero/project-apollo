        <mxCell id="title" value="AP Linux — deadline에서 IRQ, 다음 deadline까지" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=34;fontColor=#172C43;fontStyle=1;">
