        <mxCell id="separate-title" value="실제 count rate와 SW 보고값은 별도 상태" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=19;fontColor=#235D86;fontStyle=1;">
