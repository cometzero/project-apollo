        </mxCell>
        <mxCell id="actual" value="&lt;b style=&quot;font-size:21px&quot;&gt;32-bit 쓰기를 별도로 적용한 계산 예&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:19px&quot;&gt;CNTINCR=8 → 125MHz ×8 = 1GHz&lt;br&gt;virtual time 1ms → 1,000,000 count&lt;/font&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147B79;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;">
