            <mxPoint as="sourcePoint" x="48" y="1062" />
            <mxPoint as="targetPoint" x="1552" y="1062" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" value="만료 IRQ는 scheduler 입력 중 하나다. 모든 IRQ가 task switch를 일으키거나 모든 timer callback이 같은 문맥에서 실행되는 것은 아니다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#235D86;">
