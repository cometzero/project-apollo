            <mxPoint as="sourcePoint" x="48" y="1032" />
            <mxPoint as="targetPoint" x="1552" y="1032" />
          </mxGeometry>
        </mxCell>
        <mxCell id="footer" value="기능·register·배선을 비교한 결과다. FVP와의 latency, clock drift, reset retention 및 wakeup 동등성은 실행 비교가 필요하다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#235D86;">
