      </mxCell>
      <mxCell id="condition" value="만료 조건: virtual count ≥ CNTV_CVAL · ENABLE=1 · IMASK=0&#10;전달 조건: GIC enable / group / priority 및 CPU exception mask가 허용" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=21;strokeWidth=1.5;spacing=12;strokeColor=#00838A;fontSize=18;">
