        <mxCell id="reported" value="&lt;b style=&quot;font-size:21px&quot;&gt;CNTFRQ / CNTFID0 metadata&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot; style=&quot;font-size:19px&quot;&gt;rate 변경이 보고값을 자동 갱신하지 않음&lt;br&gt;1,000,000 count를 125MHz로 환산하면 8ms&lt;/font&gt;" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#235D86;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;">
          <mxGeometry as="geometry" x="842" y="716" width="680" height="111" />
        </mxCell>
        <mxCell id="measure" value="위 계산은 별도 32-bit write 조건이다. 현재 부팅의 최종 register 값·실측 오차는 조사하지 않았다." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#52657A;">
          <mxGeometry as="geometry" x="78" y="853" width="1444" height="36" />
        </mxCell>
        <mxCell id="regdetail" value="같은 0xD0도 다르다: CSS host_gtimer는 정수 CNTINCR · RSE SSE counter는 8.24 CNTSCR0" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#172C43;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=14;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#9A681E;fontStyle=1;">
