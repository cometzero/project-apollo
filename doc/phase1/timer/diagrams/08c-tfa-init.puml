@startuml
' Source: ../apollo-timer-architecture.drawio (page 08c-tfa-init)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "BL31 Platform" as p0
participant "Generic delay timer" as p1
participant "Platform frequency" as p2
participant "Delay framework" as p3

p0 -> p1 : 1. generic_delay_timer_init()
p1 -> p2 : 2. plat_get_syscnt_freq2()
p2 -> p1 : 3. 125,000,000 Hz
p1 -> p1 : 4. mult / div = 1 / 125
p1 -> p3 : 5. timer_init(&ops) · callback 등록
p3 -> p0 : 6. Delay / Timeout API 사용 가능

@enduml
