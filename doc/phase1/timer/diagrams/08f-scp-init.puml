@startuml
' Source: ../apollo-timer-architecture.drawio (page 08f-scp-init)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "Framework" as p0
participant "timer HAL" as p1
participant "gtimer driver" as p2
participant "Counter / GIC" as p3

p0 -> p1 : 1. element init · context / alarm pool 구성
p0 -> p1 : 2. bind phase · timer_bind()
p1 -> p2 : 3. driver API 연결
p0 -> p2 : 4. start phase · gtimer_start()
p2 -> p3 : 5. Counter disable → impdef / FID → enable
p0 -> p1 : 6. timer_start() · active queue 초기화
p1 -> p3 : 7. INTID34 ISR 등록 / interrupt enable

@enduml
