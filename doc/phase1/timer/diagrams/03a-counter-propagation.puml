@startuml
' Source: ../apollo-timer-architecture.drawio (page 03a-counter-propagation)
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK KR
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor #235D86
  ParticipantFontColor #172C43
  LifeLineBorderColor #94A3B8
  ArrowColor #235D86
  ArrowFontColor #172C43
  MessageAlign center
  ParticipantPadding 10
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #94A3B8
scale max 790 width

participant "Counter control" as p0
participant "SystemC Counter" as p1
participant "Mirror / libqemu" as p2
participant "QEMU Timer" as p3

p0 -> p1 : 1. count / rate / running 상태 변경
p1 -> p2 : 2. state_changed_event
p2 -> p1 : 3. snapshot_at(sc_time_stamp)
p1 -> p2 : 4. anchor count / effective rate / running
p2 -> p3 : 5. target lock 내 snapshot 적용
p3 -> p3 : 6. virtual time anchor / expiry 재계산
p3 -> p3 : 7. 이후 read: virtual elapsed로 count 계산

@enduml
