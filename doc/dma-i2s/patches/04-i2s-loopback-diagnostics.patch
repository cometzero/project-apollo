+static void dump_pcm(snd_pcm_t *pcm, const char *label)
+{
+    snd_pcm_status_t *status;
+    snd_pcm_info_t *info;
+    snd_output_t *output;
+    char path[128], line[256];
+    FILE *file;
+
+    if (!pcm)
+        return;
+    fprintf(stderr, "I2S_DIAGNOSTIC_STREAM=%s\n", label);
+    snd_pcm_status_alloca(&status);
+    if (snd_pcm_status(pcm, status) >= 0 &&
+        snd_output_stdio_attach(&output, stderr, 0) >= 0) {
+        snd_pcm_status_dump(status, output);
+        snd_output_close(output);
+    }
+    snd_pcm_info_alloca(&info);
+    if (snd_pcm_info(pcm, info) < 0)
+        return;
+    snprintf(path, sizeof(path), "/proc/asound/card%d/pcm%u%c/sub%u/status",
+             snd_pcm_info_get_card(info), snd_pcm_info_get_device(info),
+             snd_pcm_stream(pcm) == SND_PCM_STREAM_PLAYBACK ? 'p' : 'c',
+             snd_pcm_info_get_subdevice(info));
+    file = fopen(path, "r");
+    if (file) {
+        while (fgets(line, sizeof(line), file))
+            fputs(line, stderr);
+        fclose(file);
+    }
+}
+
 static void check(int rc, const char *operation)
 {
     if (rc < 0) {
         fprintf(stderr, "%s: %s\n", operation, snd_strerror(rc));
+        if (diagnostics) {
+            struct timespec now;
+
+            clock_gettime(CLOCK_MONOTONIC, &now);
+            fprintf(stderr, "I2S_DIAGNOSTIC_ERROR operation=%s rc=%d "
+                    "guest_time=%lld.%09ld received=%u written=%u\n",
+                    operation, rc, (long long)now.tv_sec, now.tv_nsec,
+                    diag_received, diag_written);
+            dump_pcm(diag_play, "playback");
+            dump_pcm(diag_capture, "capture");
+        }
         exit(1);
     }
 }
