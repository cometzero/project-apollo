+def test_demotes_fifo_rr_and_cleanup_restores_exact_state(pfdi_shell):
+    result = pfdi_shell.run('''
+audio_pfdi_demote
+cp "$TEST_SCHED_STATE" "$TEST_ROOT/demoted.json"
+cp "$AUDIO_PFDI_STATE_FILE" "$TEST_ROOT/saved.txt"
+audio_diag_cleanup
+test -z "$AUDIO_PFDI_STATE_FILE"
+''')
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert 'demote=PASS tasks=3 changed=2' in result.stdout
+    demoted = json.loads((pfdi_shell.root / 'demoted.json').read_text())
+    assert all(task == {'policy': 'SCHED_OTHER', 'priority': 0}
+               for task in demoted['tasks'].values())
+    saved = (pfdi_shell.root / 'saved.txt').read_text().splitlines()
+    assert len(saved) == 2
+    for row, tid in zip(saved, pfdi_shell.tids):
+        pid, pid_start, saved_tid, tid_start, policy, priority = row.split()
+        assert pid == saved_tid == tid
+        assert int(pid_start) > 0 and pid_start == tid_start
+        assert policy == pfdi_shell.initial_tasks[tid]['policy']
+        assert int(priority) == pfdi_shell.initial_tasks[tid]['priority']
+    assert pfdi_shell.state()['tasks'] == pfdi_shell.initial_tasks
+    assert result.stdout.count('restore=PASS') == 2
+    assert not list(pfdi_shell.root.glob('pfdi.*'))
