index 0000000000000000000000000000000000000000..fefeab7dbb8601bf91c9ad2d87442924477e9c81
--- /dev/null
+++ b/scripts/test/qbox_audio_uki.py
@@ -0,0 +1,98 @@
+"""Replace the kernel in a private, unsigned AArch64 audio-test UKI."""
+
+import hashlib
+from pathlib import Path
+import stat
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'run'))
+from autosd_uki import _objcopy, inspect_uki
+
+
+def _sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _raw_hashes(data, metadata):
+    """Include on-disk padding in the section preservation evidence."""
+    return {name: _sha(data[section['offset']:section['offset'] + section['raw_size']])
+            for name, section in metadata['sections'].items()}
+
+
+def replace_kernel(uki: Path, kernel: Path) -> dict:
+    """Atomically replace only ``uki`` after validating all section contents.
+
+    The caller must supply its private UKI copy. Signed images and symlink UKI
+    destinations are rejected. Failures before replacement leave that copy
+    unchanged; the source kernel is never modified.
+    """
+    uki, kernel = Path(uki).absolute(), Path(kernel).resolve()
+    if uki.is_symlink():
+        raise ValueError('UKI must be a private regular file, not a symlink')
+    if not uki.is_file():
+        raise ValueError('UKI must be an existing private regular file')
+    if not kernel.is_file() or not kernel.stat().st_size:
+        raise ValueError('Kernel must be a nonempty regular file')
+    if uki.samefile(kernel):
+        raise ValueError('UKI and source kernel must differ')
+
+    original = uki.read_bytes()
+    kernel_bytes = kernel.read_bytes()
+    kernel_sha256 = _sha(kernel_bytes)
+    mode = stat.S_IMODE(uki.stat().st_mode)
+    with tempfile.TemporaryDirectory(prefix='.qbox-audio-uki-', dir=uki.parent) as tmp:
+        tmp = Path(tmp)
+        source, payload, output = tmp / 'source.efi', tmp / 'Image', tmp / 'replaced.efi'
+        source.write_bytes(original)
+        payload.write_bytes(kernel_bytes)
+        before = inspect_uki(source)
+        preserved = {name: section for name, section in before['sections'].items()
+                     if name != '.linux'}
+        alignment = before['section_alignment']
+        end = max(section['rva'] + max(section['size'], section['raw_size'])
+                  for section in preserved.values())
+        rva = (end + alignment - 1) & ~(alignment - 1)
+        if rva + len(kernel_bytes) > 0xffffffff:
+            raise ValueError('Replacement kernel exceeds PE address range')
+        objcopy = _objcopy()
+        command = [objcopy, '--remove-section', '.linux',
+                   '--add-section', f'.linux={payload}',
+                   '--change-section-vma', f'.linux={before["image_base"] + rva:#x}',
+                   '--set-section-flags', '.linux=alloc,load,readonly,data,contents',
+                   str(source), str(output)]
+        subprocess.run(command, check=True, capture_output=True, text=True)
+        after = inspect_uki(output)
+        if after['sections'].keys() != before['sections'].keys():
+            raise ValueError('Kernel replacement changed the UKI section set')
+        for field in ('image_base', 'section_alignment'):
+            if after[field] != before[field]:
+                raise ValueError(f'Kernel replacement changed UKI {field}')
+        old_raw = _raw_hashes(original, before)
+        new_raw = _raw_hashes(output.read_bytes(), after)
+        for name, section in preserved.items():
+            if (any(after['sections'][name][field] != section[field]
+                    for field in ('size', 'rva', 'raw_size', 'sha256'))
+                    or new_raw[name] != old_raw[name]):
+                raise ValueError(f'Kernel replacement changed preserved section {name}')
+        linux = after['sections']['.linux']
+        if (linux['sha256'] != kernel_sha256 or linux['size'] != len(kernel_bytes)
+                or linux['rva'] != rva):
+            raise ValueError('Replacement .linux differs from source kernel')
+        if uki.is_symlink() or _sha(uki.read_bytes()) != before['sha256']:
+            raise ValueError('Private UKI changed during kernel replacement')
+        if _sha(kernel.read_bytes()) != kernel_sha256:
+            raise ValueError('Source kernel changed during kernel replacement')
+        output.chmod(mode)
+        output.replace(uki)
+
+    return {'uki': str(uki), 'kernel': str(kernel), 'kernel_sha256': kernel_sha256,
+            'source_sha256': before['sha256'], 'sha256': after['sha256'],
+            'secure_boot': False, 'objcopy': str(objcopy),
+            'before': before, 'after': after,
+            'preserved_sections': {
+                name: {'sha256': section['sha256'], 'raw_sha256': old_raw[name],
+                       'size': section['size'], 'raw_size': section['raw_size'],
+                       'rva': section['rva']}
+                for name, section in preserved.items()}}
