+def test_source_provenance_binds_dirty_and_untracked_implementation_bytes(tmp_path, monkeypatch):
+    tracked = tmp_path / 'model.c'
+    tracked.write_text('old model\n')
+    subprocess.run(['git', 'init', '-q', str(tmp_path)], check=True)
+    subprocess.run(['git', '-C', str(tmp_path), 'add', 'model.c'], check=True)
+    subprocess.run(['git', '-C', str(tmp_path), '-c', 'user.name=Fixture',
+                    '-c', 'user.email=fixture@example.invalid', '-c', 'commit.gpgsign=false',
+                    'commit', '-qm', 'fixture'], check=True)
+    tracked.write_text('new uncommitted model\n')
+    helper = tmp_path / 'new-helper.h'
+    helper.write_text('untracked telemetry\n')
+    monkeypatch.setattr(experiment, 'ROOT', tmp_path)
+    monkeypatch.setattr(experiment, 'IMPLEMENTATION_FILES', {'.': ('model.c', 'new-helper.h')})
+    result = experiment.source_provenance()['.']
+    diff = subprocess.check_output(['git', '-C', str(tmp_path), 'diff', '--binary', 'HEAD', '--',
+                                    'model.c', 'new-helper.h'])
+    assert result['tracked_diff_sha256'] == hashlib.sha256(diff).hexdigest()
+    assert result['tracked_diff_bytes'] == len(diff) > 0
+    assert result['files']['model.c']['sha256'] == hashlib.sha256(tracked.read_bytes()).hexdigest()
+    assert result['files']['new-helper.h']['sha256'] == hashlib.sha256(helper.read_bytes()).hexdigest()
+
+
+def test_prepare_validates_frozen_served_probe_when_original_changes(tmp_path, monkeypatch):
+    root = tmp_path / 'workspace'
+    script = root / 'scripts/test/qbox_audio_diagnostics.sh'
+    script.parent.mkdir(parents=True)
+    script.write_text('#!/bin/sh\n')
+    configuration = root / 'build/conf'
+    configuration.mkdir(parents=True)
+    for name in ('local.conf', 'bblayers.conf', 'templateconf.cfg'):
+        (configuration / name).write_text('test configuration\n')
+    output = tmp_path / 'output'
+    serve = output / 'http'
+    serve.mkdir(parents=True)
+    probes = tmp_path / 'source.events'
+    digest = '0123456789abcdef' * 4
+    probes.write_text(f'# exact Image SHA256 {digest}\np:sample d350_program_cmd\n')
+    monkeypatch.setattr(experiment, 'ROOT', root)
+    monkeypatch.setattr(experiment, 'source_provenance', lambda: {})
+    args = options(diagnostics=True, kprobes=probes)
+    experiment.prepare(args, output, serve)
+    probes.write_text('# Source edited after snapshot\n')
+    assert args.kprobes == (serve / 'audio-kprobes.events').absolute()
+    experiment.validate_probe_kernel(args, digest)
+    manifest = json.loads((output / 'run-manifest.json').read_text())
+    assert manifest['injected_files']['audio-kprobes.events'] == hashlib.sha256(args.kprobes.read_bytes()).hexdigest()
+
+
+def fake_process(proc, pid, ppid, executable, start=123, maps=''):
+    directory = proc / str(pid)
+    directory.mkdir(parents=True)
+    fields = ['S', str(ppid)] + ['0'] * 17 + [str(start)]
+    (directory / 'stat').write_text(f'{pid} (test process) ' + ' '.join(fields))
+    (directory / 'exe').symlink_to(executable)
+    (directory / 'maps').write_text(maps)
+
+
+def mapped_line(path, inode_offset=0):
+    stat = path.stat()
+    device = f'{os.major(stat.st_dev):02x}:{os.minor(stat.st_dev):02x}'
+    return f'1000-2000 r-xp 00000000 {device} {stat.st_ino + inode_offset} {path}\n'
+
+
+def test_loaded_runtime_uses_descendant_maps_and_caches_completed_capture(tmp_path, monkeypatch):
+    proc = tmp_path / 'proc'
+    modules = tmp_path / 'qbox/modules'
+    modules.mkdir(parents=True)
+    paths = [tmp_path / 'platforms-vp', modules / 'qemu_dma350.so',
+             modules / 'qemu_dw_apb_i2s.so', tmp_path / 'libqemu-system-aarch64.so']
+    for path in paths:
+        path.write_bytes(path.name.encode())
+    libc = tmp_path / 'libc.so.6'
+    libc.write_bytes(b'not relevant')
+    fake_process(proc, 100, 1, tmp_path / 'launcher')
+    fake_process(proc, 101, 100, tmp_path / 'wrapper')
+    fake_process(proc, 102, 101, paths[0], maps=''.join(mapped_line(p) for p in paths[1:] + [libc]))
+    # SharedMemoryCleaner forks without exec: these are not additional VPs.
+    fake_process(proc, 103, 102, paths[0], maps='')
+    fake_process(proc, 104, 103, tmp_path / 'helper')
+    fake_process(proc, 105, 104, paths[0], maps='')
+    # A different managed session must not make this capture ambiguous.
+    fake_process(proc, 999, 1, paths[0], maps='')
+    monkeypatch.setattr(experiment, 'PROC', proc)
+    output = tmp_path / 'output'
+    output.mkdir()
+    result = experiment.capture_loaded_runtime(100, output)
+    assert result['status'] == 'COLLECTED', result
+    assert result['target_pid'] == 102
+    assert result['excluded_nested_simulator_pids'] == [103, 105]
+    assert len(result['artifacts']) == 4
+    assert all(item['status'] == 'COLLECTED' for item in result['artifacts'])
+    assert {item['mapped_path'] for item in result['artifacts']} == {str(p) for p in paths}
+    assert {item['sha256'] for item in result['artifacts']} == {
+        hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    assert (output / 'loaded-runtime.maps').read_text() == (proc / '102/maps').read_text()
+    monkeypatch.setattr(experiment, '_process_tree', lambda: pytest.fail('Completed capture must be reused'))
+    assert experiment.capture_loaded_runtime(100, output) == result
+    annotated = experiment.annotate_result({'status': 'PASS'}, 'QBOX_AUDIO_DONE=0\n', options(), output)
+    assert annotated['loaded_runtime'] == result
+
+
+def test_loaded_runtime_records_inode_mismatch_without_hashing_replacement(tmp_path, monkeypatch):
+    proc = tmp_path / 'proc'
+    executable = tmp_path / 'platforms-vp'
+    executable.write_bytes(b'executable')
+    library = tmp_path / 'libqemu-system-aarch64.so'
+    library.write_bytes(b'replaced library')
+    fake_process(proc, 100, 1, tmp_path / 'launcher')
+    fake_process(proc, 101, 100, executable, maps=mapped_line(library, inode_offset=1))
+    monkeypatch.setattr(experiment, 'PROC', proc)
+    output = tmp_path / 'output'
+    output.mkdir()
+    result = experiment.capture_loaded_runtime(100, output)
+    assert result['status'] == 'NOT_COLLECTED'
+    failed = next(item for item in result['artifacts'] if item['mapped_path'] == str(library))
+    assert failed['status'] == 'NOT_COLLECTED'
+    assert 'inode/device differs' in failed['reason']
+    assert 'sha256' not in failed
+    assert json.loads((output / 'loaded-runtime.json').read_text()) == result
+
+
+def test_loaded_runtime_rejects_two_sibling_simulators(tmp_path, monkeypatch):
+    proc = tmp_path / 'proc'
+    executable = tmp_path / 'platforms-vp'
+    executable.write_bytes(b'executable')
+    fake_process(proc, 100, 1, tmp_path / 'launcher')
+    fake_process(proc, 101, 100, executable)
+    fake_process(proc, 102, 100, executable)
+    fake_process(proc, 103, 101, executable)
+    monkeypatch.setattr(experiment, 'PROC', proc)
+    result = experiment.capture_loaded_runtime(100, tmp_path / 'output')
+    assert result['status'] == 'NOT_COLLECTED'
+    assert 'one top-level descendant platforms-vp; found 2' in result['reason']
+    assert result['excluded_nested_simulator_pids'] == [103]
