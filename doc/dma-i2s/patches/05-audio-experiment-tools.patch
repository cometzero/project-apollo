+@pytest.fixture
+def pfdi_shell(tmp_path):
+    # /proc identities belong only to these children; fake chrt changes JSON.
+    children = [subprocess.Popen(['/bin/sleep', '30']) for _ in range(3)]
+    originals = {
+        child.pid: (os.sched_getscheduler(child.pid), os.sched_getparam(child.pid))
+        for child in children
+    }
+    command_dir = tmp_path / 'bin'
+    command_dir.mkdir()
+    fake_chrt = command_dir / 'chrt'
+    fake_chrt.write_text(f'#!{sys.executable}\n' + FAKE_CHRT)
+    fake_chrt.chmod(0o755)
+    fake_pidof = command_dir / 'pidof'
+    fake_pidof.write_text('''#!/bin/sh
+test "$#" -eq 1 && test "$1" = pfdi-sample-app || exit 1
+test -n "$TEST_PFDI_PIDS" || exit 1
+printf '%s\\n' "$TEST_PFDI_PIDS"
+''')
+    fake_pidof.chmod(0o755)
+    tids = [str(child.pid) for child in children]
+    initial_tasks = {
+        tids[0]: {'policy': 'SCHED_FIFO', 'priority': 99},
+        tids[1]: {'policy': 'SCHED_RR', 'priority': 37},
+        tids[2]: {'policy': 'SCHED_OTHER', 'priority': 0},
+    }
+    state_path = tmp_path / 'scheduler.json'
+    state_path.write_text(json.dumps({'tasks': initial_tasks, 'calls': []}))
+    env = os.environ | {
+        'PATH': f'{command_dir}:/usr/bin:/bin',
+        'TEST_HELPER': str(HELPER), 'TEST_ROOT': str(tmp_path),
+        'TEST_FAKE_CHRT': str(fake_chrt), 'TEST_SCHED_STATE': str(state_path),
+        'TEST_PFDI_PIDS': ' '.join(tids),
+    }
+
+    def state():
+        return json.loads(state_path.read_text())
+
+    def configure(**changes):
+        state_path.write_text(json.dumps(state() | changes))
+
+    def run(body, **environment):
+        # Assert fake chrt resolution and keep temporary rollback files local.
+        script = '''set -eu
+test "$(command -v chrt)" = "$TEST_FAKE_CHRT"
+. "$TEST_HELPER"
+mktemp() { command mktemp "$TEST_ROOT/pfdi.XXXXXX"; }
+''' + body
+        return subprocess.run(
+            ['/bin/sh', '-c', script], env=env | environment,
+            text=True, capture_output=True, timeout=10,
+        )
+
+    try:
+        yield SimpleNamespace(
+            run=run, state=state, configure=configure, tids=tids,
+            initial_tasks=initial_tasks, root=tmp_path,
+        )
+    finally:
+        try:
+            for child in children:
+                assert child.poll() is None, 'fixture process exited early'
+                assert (
+                    os.sched_getscheduler(child.pid), os.sched_getparam(child.pid)
+                ) == originals[child.pid], 'real scheduling policy was changed'
+        finally:
+            for child in children:
+                if child.poll() is None:
+                    child.terminate()
+                child.wait(timeout=3)
+
