diff --git a/scripts/test/qbox_audio_diagnostics.sh b/scripts/test/qbox_audio_diagnostics.sh
new file mode 100644
index 0000000000000000000000000000000000000000..bdb0ce6d9f4d4683f169ab201942c75f86a4c042
--- /dev/null
+++ b/scripts/test/qbox_audio_diagnostics.sh
@@ -0,0 +1,522 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+# Source from a guest suite. Add audio_diag_cleanup to the suite's exit trap.
+# No tracing, idle, IRQ affinity or scheduling policy changes occur on source.
+
+audio_diag_note() {
+    printf '%s\n' "$*" >> "$AUDIO_DIAG_DIR/collection.log" || :
+}
+
+audio_diag_snapshot() (
+    audio_snapshot_name=$1
+    audio_snapshot_dir=$AUDIO_DIAG_DIR/$audio_snapshot_name
+    mkdir -p "$audio_snapshot_dir/asound" "$audio_snapshot_dir/irq" || exit 0
+    {
+        date -u
+        uname -a
+        printf 'uptime: '; cat /proc/uptime
+        printf 'cmdline: '; cat /proc/cmdline
+        for audio_setting in /sys/devices/system/cpu/online \
+            /sys/devices/system/cpu/cpuidle/current_driver \
+            /sys/devices/system/cpu/cpuidle/current_governor_ro \
+            /proc/sys/kernel/sched_rt_runtime_us \
+            /proc/sys/kernel/sched_rt_period_us; do
+            test -r "$audio_setting" || continue
+            printf '%s: ' "$audio_setting"
+            cat "$audio_setting"
+        done
+    } > "$audio_snapshot_dir/manifest.txt" 2>&1
+    cat /proc/interrupts > "$audio_snapshot_dir/interrupts.txt" 2>/dev/null || :
+    cat /proc/asound/cards > "$audio_snapshot_dir/asound/cards" 2>/dev/null || :
+    cat /proc/asound/pcm > "$audio_snapshot_dir/asound/pcm" 2>/dev/null || :
+    for audio_pcm in /proc/asound/card*/pcm*/sub*; do
+        test -d "$audio_pcm" || continue
+        audio_pcm_name=$(printf '%s' "$audio_pcm" | tr / _)
+        for audio_pcm_file in status hw_params sw_params; do
+            test -r "$audio_pcm/$audio_pcm_file" || continue
+            cat "$audio_pcm/$audio_pcm_file" \
+                > "$audio_snapshot_dir/asound/$audio_pcm_name.$audio_pcm_file" 2>/dev/null || :
+        done
+    done
+    for audio_irq in $AUDIO_DIAG_IRQS; do
+        for audio_irq_file in smp_affinity smp_affinity_list effective_affinity_list; do
+            test -r "/proc/irq/$audio_irq/$audio_irq_file" || continue
+            cat "/proc/irq/$audio_irq/$audio_irq_file" \
+                > "$audio_snapshot_dir/irq/$audio_irq.$audio_irq_file" 2>/dev/null || :
+        done
+    done
+    {
+        for audio_idle_state in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state*; do
+            test -d "$audio_idle_state" || continue
+            for audio_idle_field in name desc latency residency time usage disable; do
+                test -r "$audio_idle_state/$audio_idle_field" || continue
+                printf '%s: ' "$audio_idle_state/$audio_idle_field"
+                cat "$audio_idle_state/$audio_idle_field"
+            done
+        done
+    } > "$audio_snapshot_dir/cpuidle.txt" 2>&1
+    {
+        for audio_task in /proc/[0-9]*; do
+            test -r "$audio_task/comm" || continue
+            audio_comm=$(cat "$audio_task/comm" 2>/dev/null) || continue
+            case "$audio_comm" in
+                i2s*|aplay|arecord|irq/*|pfdi*)
+                    printf '\nTASK %s %s\n' "$audio_task" "$audio_comm"
+                    cat "$audio_task/status" "$audio_task/sched" 2>/dev/null || :
+                    ;;
+            esac
+        done
+    } > "$audio_snapshot_dir/tasks.txt" 2>&1
+    audio_pfdi_snapshot "$audio_snapshot_dir/pfdi"
+)
+
+audio_diag_enable_event() {
+    audio_event=$1
+    audio_filter=${2-}
+    audio_event_path=$AUDIO_DIAG_INSTANCE/events/$audio_event
+    if test ! -w "$audio_event_path/enable"; then
+        audio_diag_note "NOT_COLLECTED event=$audio_event reason=unavailable"
+        return 0
+    fi
+    if test -n "$audio_filter"; then
+        if ! printf '%s\n' "$audio_filter" > "$audio_event_path/filter" 2>/dev/null; then
+            audio_diag_note "NOT_COLLECTED event=$audio_event reason=filter_rejected"
+            return 0
+        fi
+    fi
+    if printf '1\n' > "$audio_event_path/enable" 2>/dev/null; then
+        audio_diag_note "COLLECTED event=$audio_event filter=$audio_filter"
+        case "$audio_event" in
+            snd_pcm/xrun|*/alsa_xrun)
+                if test -w "$audio_event_path/trigger" && \
+                    printf 'traceoff:1\n' > "$audio_event_path/trigger" 2>/dev/null; then
+                    audio_diag_note "COLLECTED trigger=$audio_event action=traceoff:1 scope=private_instance"
+                else
+                    audio_diag_note "NOT_COLLECTED trigger=$audio_event reason=traceoff_unsupported"
+                fi
+                ;;
+        esac
+    else
+        audio_diag_note "NOT_COLLECTED event=$audio_event reason=enable_failed"
+    fi
+}
+
+audio_diag_load_kprobes() {
+    audio_probe_file=${AUDIO_DIAG_KPROBES_FILE:-/tmp/audio-kprobes.events}
+    if test ! -r "$audio_probe_file"; then
+        audio_diag_note 'NOT_COLLECTED kprobes reason=no_opt_in_definitions'
+        return 0
+    fi
+    cp "$audio_probe_file" "$AUDIO_DIAG_DIR/kprobes-requested.events" || return 0
+    if test ! -w "$AUDIO_DIAG_TRACE_ROOT/kprobe_events"; then
+        audio_diag_note 'NOT_COLLECTED kprobes reason=kprobe_events_unavailable'
+        return 0
+    fi
+    while IFS= read -r audio_probe_line || test -n "$audio_probe_line"; do
+        case "$audio_probe_line" in ''|'#'*) continue ;; esac
+        audio_probe_head=${audio_probe_line%% *}
+        audio_probe_type=${audio_probe_head%%:*}
+        audio_probe_name=${audio_probe_head#*:}
+        audio_probe_name=${audio_probe_name##*/}
+        case "$audio_probe_type" in p|r|r[0-9]*) ;; *)
+            audio_diag_note "NOT_COLLECTED kprobe=$audio_probe_head reason=invalid_type"
+            continue ;;
+        esac
+        case "$audio_probe_name" in ''|*[!a-zA-Z0-9_]*)
+            audio_diag_note "NOT_COLLECTED kprobe=$audio_probe_head reason=invalid_name"
+            continue ;;
+        esac
+        audio_probe_owned=$AUDIO_DIAG_PROBE_GROUP/$audio_probe_name
+        audio_probe_spec="$audio_probe_type:$audio_probe_owned ${audio_probe_line#* }"
+        if printf '%s\n' "$audio_probe_spec" >> "$AUDIO_DIAG_TRACE_ROOT/kprobe_events" 2>/dev/null; then
+            printf '%s\n' "$audio_probe_owned" >> "$AUDIO_DIAG_DIR/owned-kprobes.txt"
+            printf '%s\n' "$audio_probe_spec" >> "$AUDIO_DIAG_DIR/kprobes-registered.events"
+            audio_diag_enable_event "$audio_probe_owned"
+        else
+            audio_diag_note "NOT_COLLECTED kprobe=$audio_probe_name reason=registration_failed"
+        fi
+    done < "$audio_probe_file"
+}
+
+audio_diag_start() {
+    if test -n "${AUDIO_DIAG_DIR-}"; then
+        printf 'AUDIO_DIAGNOSTICS start=SKIP reason=already_started\n'
+        return 0
+    fi
+    AUDIO_DIAG_UPLOAD_URL=${1-}
+    AUDIO_DIAG_DIR=$(mktemp -d /tmp/qbox-audio-diag.XXXXXX) || return 0
+    AUDIO_DIAG_INSTANCE=
+    AUDIO_DIAG_TRACE_ROOT=
+    AUDIO_DIAG_MOUNT=
+    AUDIO_DIAG_PROBE_GROUP=qbox_audio_$$
+    AUDIO_DIAG_IRQS=$(awk '/dma[01]chan|30200000.i2s|30210000.i2s/ {gsub(":", "", $1); if ($1 ~ /^[0-9]+$/) print $1}' /proc/interrupts)
+    printf '%s\n' "$AUDIO_DIAG_IRQS" > "$AUDIO_DIAG_DIR/audio-irqs.txt"
+    audio_diag_snapshot before
+    for audio_trace_root in /sys/kernel/tracing /sys/kernel/debug/tracing; do
+        if test -r "$audio_trace_root/available_events"; then
+            AUDIO_DIAG_TRACE_ROOT=$audio_trace_root
+            break
+        fi
+    done
+    if test -z "$AUDIO_DIAG_TRACE_ROOT"; then
+        AUDIO_DIAG_MOUNT=$(mktemp -d /tmp/qbox-audio-tracefs.XXXXXX) || AUDIO_DIAG_MOUNT=
+        if test -n "$AUDIO_DIAG_MOUNT" && \
+            mount -t tracefs tracefs "$AUDIO_DIAG_MOUNT" 2>> "$AUDIO_DIAG_DIR/collection.log"; then
+            AUDIO_DIAG_TRACE_ROOT=$AUDIO_DIAG_MOUNT
+        else
+            test -z "$AUDIO_DIAG_MOUNT" || rmdir "$AUDIO_DIAG_MOUNT" 2>/dev/null || :
+            AUDIO_DIAG_MOUNT=
+        fi
+    fi
+    if test -z "$AUDIO_DIAG_TRACE_ROOT"; then
+        audio_diag_note 'NOT_COLLECTED tracing reason=tracefs_unavailable'
+        return 0
+    fi
+    cp "$AUDIO_DIAG_TRACE_ROOT/available_events" "$AUDIO_DIAG_DIR/available_events.txt" || :
+    audio_instance_candidate=$AUDIO_DIAG_TRACE_ROOT/instances/$AUDIO_DIAG_PROBE_GROUP
+    if ! mkdir "$audio_instance_candidate" 2>> "$AUDIO_DIAG_DIR/collection.log"; then
+        audio_diag_note 'NOT_COLLECTED tracing reason=private_instance_unavailable'
+        return 0
+    fi
+    AUDIO_DIAG_INSTANCE=$audio_instance_candidate
+    printf '0\n' > "$AUDIO_DIAG_INSTANCE/tracing_on" || :
+    printf 'nop\n' > "$AUDIO_DIAG_INSTANCE/current_tracer" || :
+    if ! printf '8192\n' > "$AUDIO_DIAG_INSTANCE/buffer_size_kb"; then
+        audio_diag_note 'NOT_COLLECTED tracing reason=buffer_size_failed'
+        return 0
+    fi
+    # Overwrite bounds memory even if the guest audio operation stalls.
+    test ! -w "$AUDIO_DIAG_INSTANCE/options/overwrite" || \
+        printf '1\n' > "$AUDIO_DIAG_INSTANCE/options/overwrite" || :
+    # Use a guest monotonic clock for cross-CPU correlation when available.
+    if grep -q 'mono_raw' "$AUDIO_DIAG_INSTANCE/trace_clock"; then
+        printf 'mono_raw\n' > "$AUDIO_DIAG_INSTANCE/trace_clock" || :
+    fi
+    cat "$AUDIO_DIAG_INSTANCE/buffer_size_kb" > "$AUDIO_DIAG_DIR/buffer_size_kb.txt" || :
+    cat "$AUDIO_DIAG_INSTANCE/trace_clock" > "$AUDIO_DIAG_DIR/trace_clock.txt" || :
+    audio_irq_filter=
+    audio_sched_match='comm ~ "i2s*" || comm == "aplay" || comm == "arecord" || comm ~ "pfdi*"'
+    for audio_irq in $AUDIO_DIAG_IRQS; do
+        test -z "$audio_irq_filter" || audio_irq_filter="$audio_irq_filter || "
+        audio_irq_filter="${audio_irq_filter}irq == $audio_irq"
+        audio_sched_match="$audio_sched_match || comm ~ \"irq/$audio_irq-*\""
+    done
+    if test -n "$audio_irq_filter"; then
+        audio_diag_enable_event irq/irq_handler_entry "$audio_irq_filter"
+        audio_diag_enable_event irq/irq_handler_exit "$audio_irq_filter"
+    else
+        audio_diag_note 'NOT_COLLECTED irq reason=no_audio_irq_ids'
+    fi
+    audio_diag_enable_event snd_pcm/hwptr
+    audio_diag_enable_event snd_pcm/xrun
+    audio_diag_enable_event snd_pcm/applptr
+    audio_diag_enable_event snd_pcm/hw_ptr_error
+    audio_diag_enable_event power/cpu_idle
+    audio_diag_enable_event sched/sched_wakeup "$audio_sched_match"
+    audio_diag_enable_event sched/sched_wakeup_new "$audio_sched_match"
+    audio_sched_prev=$(printf '%s' "$audio_sched_match" | sed 's/comm/prev_comm/g')
+    audio_sched_next=$(printf '%s' "$audio_sched_match" | sed 's/comm/next_comm/g')
+    audio_diag_enable_event sched/sched_switch "($audio_sched_prev) || ($audio_sched_next)"
+    audio_diag_load_kprobes
+    if printf '1\n' > "$AUDIO_DIAG_INSTANCE/tracing_on"; then
+        audio_diag_note "COLLECTED tracing instance=$AUDIO_DIAG_PROBE_GROUP"
+    else
+        audio_diag_note 'NOT_COLLECTED tracing reason=start_failed'
+    fi
+    return 0
+}
+
+audio_diag_cleanup() {
+    if test -n "${AUDIO_DIAG_INSTANCE-}"; then
+        printf '0\n' > "$AUDIO_DIAG_INSTANCE/tracing_on" 2>/dev/null || :
+        printf '0\n' > "$AUDIO_DIAG_INSTANCE/events/enable" 2>/dev/null || :
+        rmdir "$AUDIO_DIAG_INSTANCE" 2>/dev/null || :
+        AUDIO_DIAG_INSTANCE=
+    fi
+    if test -n "${AUDIO_DIAG_DIR-}" && test -r "$AUDIO_DIAG_DIR/owned-kprobes.txt"; then
+        while IFS= read -r audio_owned_probe; do
+            test -n "$audio_owned_probe" || continue
+            printf -- '-:%s\n' "$audio_owned_probe" >> "$AUDIO_DIAG_TRACE_ROOT/kprobe_events" 2>/dev/null || :
+        done < "$AUDIO_DIAG_DIR/owned-kprobes.txt"
+        : > "$AUDIO_DIAG_DIR/owned-kprobes.txt"
+    fi
+    if test -n "${AUDIO_DIAG_MOUNT-}"; then
+        if umount "$AUDIO_DIAG_MOUNT" 2>/dev/null; then
+            rmdir "$AUDIO_DIAG_MOUNT" 2>/dev/null || :
+            AUDIO_DIAG_MOUNT=
+        fi
+    fi
+    audio_idle_restore
+    audio_pfdi_restore || :
+    return 0
+}
+
+audio_diag_stop() {
+    test -n "${AUDIO_DIAG_DIR-}" || return 0
+    if test -n "${AUDIO_DIAG_INSTANCE-}"; then
+        printf '0\n' > "$AUDIO_DIAG_INSTANCE/tracing_on" 2>/dev/null || :
+        cat "$AUDIO_DIAG_INSTANCE/trace" > "$AUDIO_DIAG_DIR/trace.txt" 2>/dev/null || :
+        for audio_trace_stats in "$AUDIO_DIAG_INSTANCE"/per_cpu/cpu*/stats; do
+            test -r "$audio_trace_stats" || continue
+            audio_trace_cpu=${audio_trace_stats%/stats}
+            audio_trace_cpu=${audio_trace_cpu##*/}
+            cat "$audio_trace_stats" > "$AUDIO_DIAG_DIR/trace-$audio_trace_cpu-stats.txt" 2>/dev/null || :
+        done
+    fi
+    audio_diag_snapshot after
+    if test -n "${AUDIO_IDLE_STATE_FILE-}"; then
+        cp "$AUDIO_IDLE_STATE_FILE" "$AUDIO_DIAG_DIR/idle-original.txt" 2>/dev/null || :
+    fi
+    if test -n "${AUDIO_PFDI_STATE_FILE-}"; then
+        cp "$AUDIO_PFDI_STATE_FILE" "$AUDIO_DIAG_DIR/pfdi-original.txt" 2>/dev/null || :
+    fi
+    audio_diag_cleanup
+    audio_archive=$AUDIO_DIAG_DIR.tar.gz
+    if ! tar -czf "$audio_archive" -C "$AUDIO_DIAG_DIR" .; then
+        printf 'AUDIO_DIAGNOSTICS archive=FAIL path=%s\n' "$AUDIO_DIAG_DIR"
+        return 0
+    fi
+    if test -z "$AUDIO_DIAG_UPLOAD_URL"; then
+        printf 'AUDIO_DIAGNOSTICS upload=NOT_COLLECTED archive=%s\n' "$audio_archive"
+    # BusyBox wget handles POST files as strings; encode embedded NUL bytes.
+    elif ! base64 "$audio_archive" > "$audio_archive.b64"; then
+        printf 'AUDIO_DIAGNOSTICS upload=FAIL reason=base64_failed archive=%s\n' "$audio_archive"
+    elif timeout 30 wget -q --post-file="$audio_archive.b64" -O "$AUDIO_DIAG_DIR/upload-response.txt" \
+        "${AUDIO_DIAG_UPLOAD_URL%/}/base64" 2> "$AUDIO_DIAG_DIR/upload-error.txt"; then
+        printf 'AUDIO_DIAGNOSTICS upload=PASS archive=%s\n' "$audio_archive"
+    else
+        printf 'AUDIO_DIAGNOSTICS upload=FAIL archive=%s\n' "$audio_archive"
+    fi
+    AUDIO_DIAG_DIR=
+    return 0
+}
+
+# Explicit P5 experiment only. Keep state paths and old values from this guest.
+audio_idle_disable() {
+    test -z "${AUDIO_IDLE_STATE_FILE-}" || return 0
+    AUDIO_IDLE_STATE_FILE=$(mktemp /tmp/qbox-audio-idle.XXXXXX) || return 0
+    for audio_idle_file in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state*/disable; do
+        if test ! -r "$audio_idle_file" || test ! -w "$audio_idle_file"; then
+            continue
+        fi
+        audio_idle_previous=$(cat "$audio_idle_file") || continue
+        case "$audio_idle_previous" in 0|1) ;; *) continue ;; esac
+        printf '%s %s\n' "$audio_idle_file" "$audio_idle_previous" >> "$AUDIO_IDLE_STATE_FILE"
+        if ! printf '1\n' > "$audio_idle_file"; then
+            printf 'AUDIO_IDLE disable=FAIL path=%s\n' "$audio_idle_file"
+        fi
+    done
+    if test -n "${AUDIO_DIAG_DIR-}"; then
+        cp "$AUDIO_IDLE_STATE_FILE" "$AUDIO_DIAG_DIR/idle-original.txt" || :
+    fi
+    printf 'AUDIO_IDLE saved=%s states=%s\n' "$AUDIO_IDLE_STATE_FILE" "$(wc -l < "$AUDIO_IDLE_STATE_FILE")"
+    if test ! -s "$AUDIO_IDLE_STATE_FILE"; then
+        printf 'AUDIO_IDLE disable=NOT_COLLECTED reason=no_writable_idle_states\n'
+    fi
+    return 0
+}
+
+audio_idle_restore() {
+    test -n "${AUDIO_IDLE_STATE_FILE-}" && test -r "$AUDIO_IDLE_STATE_FILE" || return 0
+    audio_idle_failed=$AUDIO_IDLE_STATE_FILE.failed
+    : > "$audio_idle_failed"
+    while read -r audio_idle_file audio_idle_previous; do
+        case "$audio_idle_file" in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state*/disable) ;; *) continue ;; esac
+        case "$audio_idle_previous" in 0|1) ;; *) continue ;; esac
+        if ! printf '%s\n' "$audio_idle_previous" > "$audio_idle_file" 2>/dev/null; then
+            printf 'AUDIO_IDLE restore=FAIL path=%s\n' "$audio_idle_file"
+            printf '%s %s\n' "$audio_idle_file" "$audio_idle_previous" >> "$audio_idle_failed"
+        fi
+    done < "$AUDIO_IDLE_STATE_FILE"
+    if test -s "$audio_idle_failed"; then
+        mv "$audio_idle_failed" "$AUDIO_IDLE_STATE_FILE"
+    else
+        rm -f "$AUDIO_IDLE_STATE_FILE" "$audio_idle_failed"
+        AUDIO_IDLE_STATE_FILE=
+    fi
+    return 0
+}
+
+audio_pfdi_note() {
+    printf '%s\n' "$*"
+    if test -n "${AUDIO_DIAG_DIR-}"; then
+        printf '%s\n' "$*" >> "$AUDIO_DIAG_DIR/pfdi-scheduling.log" || :
+    fi
+}
+
+audio_pfdi_starttime() {
+    test -r "/proc/$1/stat" || return 1
+    awk '{sub(/^.*\) /, ""); print $20}' "/proc/$1/stat"
+}
+
+audio_pfdi_manifest() (
+    printf 'PFDI_SERVICE phase=%s pids=%s\n' "$1" "$(pidof pfdi-sample-app 2>/dev/null || :)"
+    for audio_pfdi_file in /usr/bin/pfdi-sample-app /etc/pfdi/pfdi_test_config_0.pack \
+        /run/pfdi-sample-app.log; do
+        if test -r "$audio_pfdi_file"; then
+            printf 'PFDI_SHA256 '
+            sha256sum "$audio_pfdi_file" || :
+        else
+            printf 'PFDI_FILE path=%s status=NOT_COLLECTED\n' "$audio_pfdi_file"
+        fi
+    done
+)
+
+audio_pfdi_snapshot() (
+    audio_pfdi_snapshot_dir=$1
+    mkdir -p "$audio_pfdi_snapshot_dir" || exit 0
+    audio_pfdi_manifest snapshot > "$audio_pfdi_snapshot_dir/manifest.txt" 2>&1
+    tail -n 40 /run/pfdi-sample-app.log > "$audio_pfdi_snapshot_dir/service-log-tail.txt" 2>/dev/null || :
+    for audio_pfdi_pid in $(pidof pfdi-sample-app 2>/dev/null || :); do
+        for audio_pfdi_task in /proc/"$audio_pfdi_pid"/task/[0-9]*; do
+            test -d "$audio_pfdi_task" || continue
+            audio_pfdi_tid=${audio_pfdi_task##*/}
+            {
+                printf 'PFDI_TASK pid=%s tid=%s starttime=%s\n' "$audio_pfdi_pid" \
+                    "$audio_pfdi_tid" "$(audio_pfdi_starttime "$audio_pfdi_tid")"
+                cat "$audio_pfdi_task/status" "$audio_pfdi_task/sched" 2>/dev/null || :
+                if command -v chrt >/dev/null 2>&1; then
+                    LC_ALL=C chrt -p "$audio_pfdi_tid" || :
+                fi
+            } > "$audio_pfdi_snapshot_dir/$audio_pfdi_pid.$audio_pfdi_tid.txt" 2>&1
+        done
+    done
+)
+
+# Explicit P4 experiment only; never stop the service or change its affinity.
+audio_pfdi_demote() {
+    if test -n "${AUDIO_PFDI_STATE_FILE-}"; then
+        audio_pfdi_note 'PFDI_SCHED demote=FAIL reason=state_already_active'
+        return 1
+    fi
+    if ! command -v chrt >/dev/null 2>&1; then
+        audio_pfdi_note 'PFDI_SCHED demote=FAIL reason=chrt_unavailable'
+        return 1
+    fi
+    audio_pfdi_pids=$(pidof pfdi-sample-app 2>/dev/null) || audio_pfdi_pids=
+    if test -z "$audio_pfdi_pids"; then
+        audio_pfdi_note 'PFDI_SCHED demote=FAIL reason=no_service_tasks'
+        return 1
+    fi
+    AUDIO_PFDI_STATE_FILE=$(mktemp /tmp/qbox-audio-pfdi.XXXXXX) || return 1
+    audio_pfdi_manifest before
+    audio_pfdi_failed=0
+    audio_pfdi_tasks=0
+    audio_pfdi_changed=0
+    for audio_pfdi_pid in $audio_pfdi_pids; do
+        audio_pfdi_pid_start=$(audio_pfdi_starttime "$audio_pfdi_pid") || audio_pfdi_pid_start=
+        for audio_pfdi_task in /proc/"$audio_pfdi_pid"/task/[0-9]*; do
+            test -d "$audio_pfdi_task" || continue
+            audio_pfdi_tasks=$((audio_pfdi_tasks + 1))
+            audio_pfdi_tid=${audio_pfdi_task##*/}
+            audio_pfdi_tid_start=$(audio_pfdi_starttime "$audio_pfdi_tid") || audio_pfdi_tid_start=
+            if test -z "$audio_pfdi_pid_start" || test -z "$audio_pfdi_tid_start" || \
+                ! audio_pfdi_sched=$(LC_ALL=C chrt -p "$audio_pfdi_tid" 2>&1); then
+                audio_pfdi_note "PFDI_SCHED demote=FAIL tid=$audio_pfdi_tid reason=read_state_failed"
+                audio_pfdi_failed=1
+                continue
+            fi
+            audio_pfdi_policy=$(printf '%s\n' "$audio_pfdi_sched" | sed -n 's/.*current scheduling policy: //p')
+            audio_pfdi_priority=$(printf '%s\n' "$audio_pfdi_sched" | sed -n 's/.*current scheduling priority: //p')
+            audio_pfdi_note "PFDI_SCHED phase=before pid=$audio_pfdi_pid tid=$audio_pfdi_tid policy=$audio_pfdi_policy priority=$audio_pfdi_priority"
+            case "$audio_pfdi_policy:$audio_pfdi_priority" in
+                SCHED_FIFO:[0-9]*|SCHED_RR:[0-9]*) ;;
+                SCHED_OTHER:0|SCHED_BATCH:0|SCHED_IDLE:0)
+                    audio_pfdi_note "PFDI_SCHED tid=$audio_pfdi_tid action=UNCHANGED reason=not_fifo_or_rr"
+                    continue ;;
+                *)
+                    audio_pfdi_note "PFDI_SCHED demote=FAIL tid=$audio_pfdi_tid reason=unsupported_state"
+                    audio_pfdi_failed=1
+                    continue ;;
+            esac
+            if ! printf '%s %s %s %s %s %s\n' "$audio_pfdi_pid" "$audio_pfdi_pid_start" \
+                "$audio_pfdi_tid" "$audio_pfdi_tid_start" "$audio_pfdi_policy" \
+                "$audio_pfdi_priority" >> "$AUDIO_PFDI_STATE_FILE"; then
+                audio_pfdi_note "PFDI_SCHED demote=FAIL tid=$audio_pfdi_tid reason=save_state_failed"
+                audio_pfdi_failed=1
+                continue
+            fi
+            if test ! -d "/proc/$audio_pfdi_pid/task/$audio_pfdi_tid" || \
+                test "$(audio_pfdi_starttime "$audio_pfdi_pid")" != "$audio_pfdi_pid_start" || \
+                test "$(audio_pfdi_starttime "$audio_pfdi_tid")" != "$audio_pfdi_tid_start"; then
+                audio_pfdi_note "PFDI_SCHED demote=FAIL tid=$audio_pfdi_tid reason=identity_changed"
+                audio_pfdi_failed=1
+                continue
+            fi
+            if ! LC_ALL=C chrt -o -p 0 "$audio_pfdi_tid"; then
+                audio_pfdi_note "PFDI_SCHED demote=FAIL tid=$audio_pfdi_tid reason=chrt_failed"
+                audio_pfdi_failed=1
+                continue
+            fi
+            audio_pfdi_after=$(LC_ALL=C chrt -p "$audio_pfdi_tid" 2>&1) || audio_pfdi_after=
+            if ! printf '%s\n' "$audio_pfdi_after" | grep -q 'current scheduling policy: SCHED_OTHER$' || \
+                ! printf '%s\n' "$audio_pfdi_after" | grep -q 'current scheduling priority: 0$'; then
+                audio_pfdi_note "PFDI_SCHED demote=FAIL tid=$audio_pfdi_tid reason=verify_failed"
+                audio_pfdi_failed=1
+                continue
+            fi
+            audio_pfdi_changed=$((audio_pfdi_changed + 1))
+            audio_pfdi_note "PFDI_SCHED phase=after pid=$audio_pfdi_pid tid=$audio_pfdi_tid policy=SCHED_OTHER priority=0"
+        done
+    done
+    audio_pfdi_manifest after
+    if test "$audio_pfdi_tasks" -eq 0 || test "$audio_pfdi_failed" -ne 0; then
+        audio_pfdi_note "PFDI_SCHED demote=FAIL tasks=$audio_pfdi_tasks changed=$audio_pfdi_changed"
+        audio_pfdi_restore || :
+        return 1
+    fi
+    audio_pfdi_note "PFDI_SCHED demote=PASS tasks=$audio_pfdi_tasks changed=$audio_pfdi_changed saved=$AUDIO_PFDI_STATE_FILE"
+    return 0
+}
+
+audio_pfdi_restore() {
+    test -n "${AUDIO_PFDI_STATE_FILE-}" || return 0
+    if test ! -r "$AUDIO_PFDI_STATE_FILE"; then
+        audio_pfdi_note 'PFDI_SCHED restore=FAIL reason=state_file_missing'
+        return 1
+    fi
+    audio_pfdi_restore_failed=$AUDIO_PFDI_STATE_FILE.failed
+    : > "$audio_pfdi_restore_failed" || return 1
+    audio_pfdi_restore_error=0
+    audio_pfdi_save_error=0
+    while read -r audio_pfdi_pid audio_pfdi_pid_start audio_pfdi_tid \
+        audio_pfdi_tid_start audio_pfdi_policy audio_pfdi_priority; do
+        if test ! -d "/proc/$audio_pfdi_pid/task/$audio_pfdi_tid"; then
+            audio_pfdi_note "PFDI_SCHED restore=SKIP pid=$audio_pfdi_pid tid=$audio_pfdi_tid reason=task_exited"
+            continue
+        fi
+        if test "$(audio_pfdi_starttime "$audio_pfdi_pid")" != "$audio_pfdi_pid_start" || \
+            test "$(audio_pfdi_starttime "$audio_pfdi_tid")" != "$audio_pfdi_tid_start"; then
+            audio_pfdi_note "PFDI_SCHED restore=SKIP pid=$audio_pfdi_pid tid=$audio_pfdi_tid reason=identity_changed"
+            continue
+        fi
+        audio_pfdi_flag=
+        case "$audio_pfdi_policy" in SCHED_FIFO) audio_pfdi_flag=-f ;; SCHED_RR) audio_pfdi_flag=-r ;; esac
+        if test -n "$audio_pfdi_flag" && \
+            LC_ALL=C chrt "$audio_pfdi_flag" -p "$audio_pfdi_priority" "$audio_pfdi_tid"; then
+            audio_pfdi_restored=$(LC_ALL=C chrt -p "$audio_pfdi_tid" 2>&1) || audio_pfdi_restored=
+            if printf '%s\n' "$audio_pfdi_restored" | grep -q "current scheduling policy: $audio_pfdi_policy\$" && \
+                printf '%s\n' "$audio_pfdi_restored" | grep -q "current scheduling priority: $audio_pfdi_priority\$"; then
+                audio_pfdi_note "PFDI_SCHED restore=PASS pid=$audio_pfdi_pid tid=$audio_pfdi_tid policy=$audio_pfdi_policy priority=$audio_pfdi_priority"
+                continue
+            fi
+        fi
+        audio_pfdi_note "PFDI_SCHED restore=FAIL pid=$audio_pfdi_pid tid=$audio_pfdi_tid policy=$audio_pfdi_policy priority=$audio_pfdi_priority"
+        audio_pfdi_restore_error=1
+        if ! printf '%s %s %s %s %s %s\n' "$audio_pfdi_pid" "$audio_pfdi_pid_start" \
+            "$audio_pfdi_tid" "$audio_pfdi_tid_start" "$audio_pfdi_policy" \
+            "$audio_pfdi_priority" >> "$audio_pfdi_restore_failed"; then
+            audio_pfdi_save_error=1
+        fi
+    done < "$AUDIO_PFDI_STATE_FILE"
+    audio_pfdi_manifest restored
+    if test "$audio_pfdi_restore_error" -ne 0; then
+        if test "$audio_pfdi_save_error" -eq 0; then
+            mv "$audio_pfdi_restore_failed" "$AUDIO_PFDI_STATE_FILE" || :
+        fi
+        return 1
+    fi
+    rm -f "$AUDIO_PFDI_STATE_FILE" "$audio_pfdi_restore_failed"
+    AUDIO_PFDI_STATE_FILE=
+    return 0
+}
diff --git a/scripts/test/qbox_audio_dma_cfs.sh b/scripts/test/qbox_audio_dma_cfs.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2c97c4ce655d9e169bfdb7b04863bd9ae2add164
--- /dev/null
+++ b/scripts/test/qbox_audio_dma_cfs.sh
@@ -0,0 +1,327 @@
+#!/bin/sh
+# Diagnostic only: demote the four existing INTID 390 audio IRQ threads.
+# Source after qbox_audio_diagnostics.sh; the suite owns the exit trap.
+# Do not change the suite, PFDI, IRQ affinity, clocks, or transfer parameters.
+
+audio_dma_irq_sched_read() {
+    audio_dma_irq_sched=$(LC_ALL=C chrt -p "$1" 2>&1) || return 1
+    audio_dma_irq_policy=$(printf '%s\n' "$audio_dma_irq_sched" |
+        sed -n 's/.*current scheduling policy: //p')
+    audio_dma_irq_priority=$(printf '%s\n' "$audio_dma_irq_sched" |
+        sed -n 's/.*current scheduling priority: //p')
+    test -n "$audio_dma_irq_policy" && test -n "$audio_dma_irq_priority"
+}
+
+audio_dma_irq_identity() {
+    test -r "/proc/$1/comm" || return 1
+    test "$(audio_pfdi_starttime "$1")" = "$2" || return 1
+    test "$(cat "/proc/$1/comm")" = "$3"
+}
+
+audio_dma_irq_setup_fail() {
+    printf 'AUDIO_DMA_IRQ_OTHER_SETUP=FAIL reason=%s\n' "$1"
+    audio_experiment_cleanup || :
+    return 1
+}
+
+audio_dma_irq_original_setup() {
+    if test -n "${AUDIO_DMA_IRQ_STATE_DIR-}"; then
+        printf 'AUDIO_DMA_IRQ_OTHER_SETUP=FAIL reason=already_active\n'
+        return 1
+    fi
+    if ! command -v chrt >/dev/null 2>&1 ||
+        ! command -v audio_pfdi_starttime >/dev/null 2>&1; then
+        printf 'AUDIO_DMA_IRQ_OTHER_SETUP=FAIL reason=missing_helper\n'
+        return 1
+    fi
+    if ! audio_dma_irq_sched_read "$$" ||
+        test "$audio_dma_irq_policy:$audio_dma_irq_priority" != SCHED_OTHER:0; then
+        printf 'AUDIO_DMA_IRQ_OTHER_SETUP=FAIL reason=suite_not_other0\n'
+        return 1
+    fi
+    printf 'AUDIO_DMA_IRQ_SUITE pid=%s policy=%s priority=%s\n' \
+        "$$" "$audio_dma_irq_policy" "$audio_dma_irq_priority"
+
+    # Match the GIC controller and INTID as separate fields, never substrings.
+    # Require exactly the four audio actions before the memory test starts.
+    audio_dma_irq_number=$(awk '
+        $1 ~ /^[0-9]+:$/ {
+            for (i = 2; i < NF; i++) {
+                if ($i == "GICv3" && $(i + 1) == "390") {
+                    matches++
+                    irq = $1
+                    sub(/:$/, "", irq)
+                    names = ""
+                    for (j = i + 3; j <= NF; j++) names = names $j
+                    count = split(names, actions, ",")
+                    valid = $(i + 2) == "Level" && count == 4
+                    for (name in seen) delete seen[name]
+                    for (j = 1; j <= count; j++) {
+                        if (actions[j] !~ /^dma1chan[0-3]$/ || seen[actions[j]]++)
+                            valid = 0
+                    }
+                }
+            }
+        }
+        END { if (matches == 1 && valid) print irq; else exit 1 }
+    ' /proc/interrupts) || {
+        printf 'AUDIO_DMA_IRQ_OTHER_SETUP=FAIL reason=irq_mapping_or_actions\n'
+        return 1
+    }
+    AUDIO_DMA_IRQ_STATE_DIR=$(mktemp -d /tmp/qbox-audio-dma-irq.XXXXXX) || return 1
+    if ! : > "$AUDIO_DMA_IRQ_STATE_DIR/original" ||
+        ! : > "$AUDIO_DMA_IRQ_STATE_DIR/attempted"; then
+        audio_dma_irq_setup_fail state_file_creation
+        return 1
+    fi
+
+    # TASK_COMM_LEN can truncate channel suffixes. The exact irq/<IRQ>-
+    # prefix plus the four /proc/interrupts actions identifies the group.
+    audio_dma_irq_count=0
+    for audio_dma_irq_proc in /proc/[0-9]*; do
+        test -r "$audio_dma_irq_proc/comm" || continue
+        audio_dma_irq_comm=$(cat "$audio_dma_irq_proc/comm" 2>/dev/null) || continue
+        case "$audio_dma_irq_comm" in
+            "irq/$audio_dma_irq_number-"*) ;;
+            *) continue ;;
+        esac
+        audio_dma_irq_pid=${audio_dma_irq_proc##*/}
+        audio_dma_irq_start=$(audio_pfdi_starttime "$audio_dma_irq_pid") || {
+            audio_dma_irq_setup_fail read_starttime
+            return 1
+        }
+        case "$audio_dma_irq_start" in ''|*[!0-9]*)
+            audio_dma_irq_setup_fail invalid_starttime
+            return 1 ;;
+        esac
+        if ! audio_dma_irq_sched_read "$audio_dma_irq_pid" ||
+            test "$audio_dma_irq_policy:$audio_dma_irq_priority" != SCHED_FIFO:50 ||
+            ! audio_dma_irq_identity "$audio_dma_irq_pid" "$audio_dma_irq_start" "$audio_dma_irq_comm"; then
+            audio_dma_irq_setup_fail original_policy_or_identity
+            return 1
+        fi
+        printf 'AUDIO_DMA_IRQ_BEFORE irq=%s pid=%s starttime=%s comm=%s policy=%s priority=%s\n' \
+            "$audio_dma_irq_number" "$audio_dma_irq_pid" "$audio_dma_irq_start" \
+            "$audio_dma_irq_comm" "$audio_dma_irq_policy" "$audio_dma_irq_priority"
+        if ! printf '%s %s %s %s %s\n' "$audio_dma_irq_pid" "$audio_dma_irq_start" \
+            "$audio_dma_irq_comm" "$audio_dma_irq_policy" "$audio_dma_irq_priority" \
+            >> "$AUDIO_DMA_IRQ_STATE_DIR/original"; then
+            audio_dma_irq_setup_fail save_original
+            return 1
+        fi
+        audio_dma_irq_count=$((audio_dma_irq_count + 1))
+    done
+    if test "$audio_dma_irq_count" -ne 4; then
+        audio_dma_irq_setup_fail "expected_four_found_$audio_dma_irq_count"
+        return 1
+    fi
+
+    # All four original states are saved before the first policy change.
+    # Journal before chrt so cleanup also covers interrupted/failed attempts.
+    while read -r audio_dma_irq_pid audio_dma_irq_start audio_dma_irq_comm \
+        audio_dma_irq_saved_policy audio_dma_irq_saved_priority; do
+        if ! audio_dma_irq_identity "$audio_dma_irq_pid" "$audio_dma_irq_start" "$audio_dma_irq_comm" ||
+            ! audio_dma_irq_sched_read "$audio_dma_irq_pid" ||
+            test "$audio_dma_irq_policy:$audio_dma_irq_priority" != SCHED_FIFO:50; then
+            audio_dma_irq_setup_fail prechange_identity_or_policy
+            return 1
+        fi
+        if ! printf '%s %s %s %s %s\n' "$audio_dma_irq_pid" "$audio_dma_irq_start" \
+            "$audio_dma_irq_comm" "$audio_dma_irq_saved_policy" "$audio_dma_irq_saved_priority" \
+            >> "$AUDIO_DMA_IRQ_STATE_DIR/attempted"; then
+            audio_dma_irq_setup_fail save_attempt
+            return 1
+        fi
+        if ! LC_ALL=C chrt -o -p 0 "$audio_dma_irq_pid" ||
+            ! audio_dma_irq_identity "$audio_dma_irq_pid" "$audio_dma_irq_start" "$audio_dma_irq_comm" ||
+            ! audio_dma_irq_sched_read "$audio_dma_irq_pid" ||
+            test "$audio_dma_irq_policy:$audio_dma_irq_priority" != SCHED_OTHER:0; then
+            audio_dma_irq_setup_fail change_or_readback
+            return 1
+        fi
+        printf 'AUDIO_DMA_IRQ_AFTER irq=%s pid=%s starttime=%s policy=%s priority=%s\n' \
+            "$audio_dma_irq_number" "$audio_dma_irq_pid" "$audio_dma_irq_start" \
+            "$audio_dma_irq_policy" "$audio_dma_irq_priority"
+    done < "$AUDIO_DMA_IRQ_STATE_DIR/original"
+    printf 'AUDIO_DMA_IRQ_OTHER_SETUP=PASS irq=%s threads=4 suite=OTHER0 pfdi=UNCHANGED affinity=UNCHANGED\n' \
+        "$audio_dma_irq_number"
+}
+
+audio_dma_irq_original_cleanup() {
+    test -n "${AUDIO_DMA_IRQ_STATE_DIR-}" || return 0
+    if test ! -r "$AUDIO_DMA_IRQ_STATE_DIR/attempted"; then
+        printf 'AUDIO_DMA_IRQ_OTHER_RESTORE=FAIL reason=journal_missing\n'
+        return 1
+    fi
+    audio_dma_irq_restore_failed=0
+    audio_dma_irq_restored=0
+    # Use only saved PIDs; never discover new memory-test IRQ threads here.
+    while read -r audio_dma_irq_pid audio_dma_irq_start audio_dma_irq_comm \
+        audio_dma_irq_saved_policy audio_dma_irq_saved_priority; do
+        if test "$audio_dma_irq_saved_policy:$audio_dma_irq_saved_priority" != SCHED_FIFO:50 ||
+            ! audio_dma_irq_identity "$audio_dma_irq_pid" "$audio_dma_irq_start" "$audio_dma_irq_comm"; then
+            printf 'AUDIO_DMA_IRQ_RESTORE=FAIL pid=%s reason=identity_or_saved_policy\n' "$audio_dma_irq_pid"
+            audio_dma_irq_restore_failed=1
+            continue
+        fi
+        if ! LC_ALL=C chrt -f -p "$audio_dma_irq_saved_priority" "$audio_dma_irq_pid" ||
+            ! audio_dma_irq_identity "$audio_dma_irq_pid" "$audio_dma_irq_start" "$audio_dma_irq_comm" ||
+            ! audio_dma_irq_sched_read "$audio_dma_irq_pid" ||
+            test "$audio_dma_irq_policy:$audio_dma_irq_priority" != SCHED_FIFO:50; then
+            printf 'AUDIO_DMA_IRQ_RESTORE=FAIL pid=%s reason=change_or_readback\n' "$audio_dma_irq_pid"
+            audio_dma_irq_restore_failed=1
+            continue
+        fi
+        audio_dma_irq_restored=$((audio_dma_irq_restored + 1))
+        printf 'AUDIO_DMA_IRQ_RESTORE=PASS pid=%s starttime=%s policy=%s priority=%s\n' \
+            "$audio_dma_irq_pid" "$audio_dma_irq_start" "$audio_dma_irq_policy" "$audio_dma_irq_priority"
+    done < "$AUDIO_DMA_IRQ_STATE_DIR/attempted"
+    if test "$audio_dma_irq_restore_failed" -ne 0; then
+        printf 'AUDIO_DMA_IRQ_OTHER_RESTORE=FAIL restored=%s state=%s\n' \
+            "$audio_dma_irq_restored" "$AUDIO_DMA_IRQ_STATE_DIR"
+        return 1
+    fi
+    rm -f "$AUDIO_DMA_IRQ_STATE_DIR/original" "$AUDIO_DMA_IRQ_STATE_DIR/attempted" || return 1
+    rmdir "$AUDIO_DMA_IRQ_STATE_DIR" || return 1
+    AUDIO_DMA_IRQ_STATE_DIR=
+    printf 'AUDIO_DMA_IRQ_OTHER_RESTORE=PASS restored=%s\n' "$audio_dma_irq_restored"
+}
+
+
+# Only the three audio executable names receive a niceness adjustment.
+# The suite and IRQ/PFDI workers retain their existing niceness.
+audio_nice10_prepare() {
+    if test -n "${AUDIO_NICE10_DIR-}" || test "${AUDIO_NICE10_PATH_SAVED:-0}" -ne 0; then
+        printf 'AUDIO_NICE10_SETUP=FAIL reason=already_active\n'
+        return 1
+    fi
+    AUDIO_NICE10_ORIGINAL_PATH=$PATH
+    AUDIO_NICE10_PATH_SAVED=1
+    audio_nice10_stat=$(awk '{sub(/^.*\) /, ""); print $17 ":" $39 ":" $20}' "/proc/$$/stat") || return 1
+    case "$audio_nice10_stat" in
+        0:0:[0-9]*) ;;
+        *) printf 'AUDIO_NICE10_SETUP=FAIL reason=suite_not_other_nice0 stat=%s\n' "$audio_nice10_stat"; return 1 ;;
+    esac
+    AUDIO_NICE10_DIR=$(mktemp -d /tmp/qbox-audio-nice10.XXXXXX) || return 1
+    audio_nice10_native=$(command -v nice) || return 1
+    case "$audio_nice10_native" in /*) ;; *) return 1 ;; esac
+    test -f "$audio_nice10_native" && test -x "$audio_nice10_native" || return 1
+    printf '%s\n' "$audio_nice10_native" > "$AUDIO_NICE10_DIR/nice.real" || return 1
+
+    cat > "$AUDIO_NICE10_DIR/launch.sh" <<'AUDIO_NICE10_LAUNCH'
+#!/bin/sh
+set -eu
+audio_nice10_dir=${0%/*}
+audio_nice10_app=${0##*/}
+case "$audio_nice10_app" in i2s-loopback|aplay|arecord) ;; *) exit 1 ;; esac
+IFS= read -r audio_nice10_real < "$audio_nice10_dir/$audio_nice10_app.real"
+IFS= read -r audio_nice10_native < "$audio_nice10_dir/nice.real"
+audio_nice10_stat=$(awk '{sub(/^.*\) /, ""); print $17 ":" $39 ":" $20}' "/proc/$$/stat")
+case "$audio_nice10_stat" in
+    0:0:[0-9]*) ;;
+    *) printf 'AUDIO_NICE10_EXEC=FAIL app=%s reason=original_not_other_nice0 stat=%s\n' "$audio_nice10_app" "$audio_nice10_stat" >&2; exit 1 ;;
+esac
+printf 'AUDIO_NICE10_BEFORE app=%s pid=%s stat_nice_policy_start=%s\n' "$audio_nice10_app" "$$" "$audio_nice10_stat" >&2
+exec "$audio_nice10_native" -n -10 /bin/sh "$audio_nice10_dir/enter.sh" \
+    "$audio_nice10_app" "$$" "$audio_nice10_stat" "$audio_nice10_real" "$@"
+AUDIO_NICE10_LAUNCH
+    test "$?" -eq 0 || return 1
+
+    cat > "$AUDIO_NICE10_DIR/enter.sh" <<'AUDIO_NICE10_ENTER'
+#!/bin/sh
+set -eu
+audio_nice10_app=$1
+audio_nice10_pid=$2
+audio_nice10_before=$3
+shift 3
+audio_nice10_stat=$(awk '{sub(/^.*\) /, ""); print $17 ":" $39 ":" $20}' "/proc/$$/stat")
+case "$audio_nice10_stat" in
+    -10:0:[0-9]*) ;;
+    *) printf 'AUDIO_NICE10_EXEC=FAIL app=%s reason=nice_readback stat=%s\n' "$audio_nice10_app" "$audio_nice10_stat" >&2; exit 1 ;;
+esac
+if test "$$" != "$audio_nice10_pid" ||
+    test "${audio_nice10_stat##*:}" != "${audio_nice10_before##*:}"; then
+    printf 'AUDIO_NICE10_EXEC=FAIL app=%s reason=exec_identity\n' "$audio_nice10_app" >&2
+    exit 1
+fi
+printf 'AUDIO_NICE10_READBACK=PASS app=%s pid=%s nice=-10 policy=SCHED_OTHER stat_nice_policy_start=%s next_exec=%s\n' \
+    "$audio_nice10_app" "$$" "$audio_nice10_stat" "$1" >&2
+# Keep the original invocation path: arecord may be an argv[0]-sensitive link.
+exec "$@"
+AUDIO_NICE10_ENTER
+    test "$?" -eq 0 || return 1
+
+    for audio_nice10_app in i2s-loopback aplay arecord; do
+        audio_nice10_real=$(command -v "$audio_nice10_app") || return 1
+        case "$audio_nice10_real" in /*) ;; *) return 1 ;; esac
+        test -f "$audio_nice10_real" && test -x "$audio_nice10_real" || return 1
+        audio_nice10_resolved=$(readlink -f "$audio_nice10_real") || return 1
+        audio_nice10_sha=$(sha256sum "$audio_nice10_real") || return 1
+        printf 'AUDIO_NICE10_ORIGINAL app=%s invocation=%s resolved=%s sha256=%s\n' \
+            "$audio_nice10_app" "$audio_nice10_real" "$audio_nice10_resolved" "${audio_nice10_sha%% *}" || return 1
+        printf '%s\n' "$audio_nice10_real" > "$AUDIO_NICE10_DIR/$audio_nice10_app.real" || return 1
+        cp "$AUDIO_NICE10_DIR/launch.sh" "$AUDIO_NICE10_DIR/$audio_nice10_app" || return 1
+        chmod 755 "$AUDIO_NICE10_DIR/$audio_nice10_app" || return 1
+    done
+}
+
+audio_experiment_setup() {
+    audio_nice10_setup_rc=0
+    audio_nice10_prepare || audio_nice10_setup_rc=$?
+    if test "$audio_nice10_setup_rc" -eq 0; then
+        audio_dma_irq_original_setup || audio_nice10_setup_rc=$?
+    fi
+    if test "$audio_nice10_setup_rc" -ne 0; then
+        printf 'AUDIO_IRQ_OTHER_NICE10_SETUP=FAIL rc=%s\n' "$audio_nice10_setup_rc"
+        audio_experiment_cleanup || :
+        return "$audio_nice10_setup_rc"
+    fi
+    PATH=$AUDIO_NICE10_DIR:$AUDIO_NICE10_ORIGINAL_PATH
+    export PATH
+    hash -r
+    for audio_nice10_app in i2s-loopback aplay arecord; do
+        if test "$(command -v "$audio_nice10_app")" != "$AUDIO_NICE10_DIR/$audio_nice10_app"; then
+            printf 'AUDIO_IRQ_OTHER_NICE10_SETUP=FAIL reason=wrapper_resolution app=%s\n' "$audio_nice10_app"
+            audio_experiment_cleanup || :
+            return 1
+        fi
+    done
+    printf 'AUDIO_IRQ_OTHER_NICE10_SETUP=PASS suite=OTHER0_nice0 audio=OTHER0_nice-10 irq=OTHER0 pfdi=UNCHANGED affinity=UNCHANGED\n'
+}
+
+audio_experiment_cleanup() {
+    audio_nice10_cleanup_rc=0
+    if test "${AUDIO_NICE10_PATH_SAVED:-0}" -eq 1; then
+        PATH=$AUDIO_NICE10_ORIGINAL_PATH
+        export PATH
+        hash -r || audio_nice10_cleanup_rc=$?
+        AUDIO_NICE10_PATH_SAVED=0
+        printf 'AUDIO_NICE10_PATH_RESTORE=PASS\n'
+    fi
+    # Always attempt IRQ restoration, even if PATH or wrapper cleanup fails.
+    audio_dma_irq_original_cleanup || {
+        audio_nice10_step_rc=$?
+        if test "$audio_nice10_cleanup_rc" -eq 0; then audio_nice10_cleanup_rc=$audio_nice10_step_rc; fi
+    }
+    if test -n "${AUDIO_NICE10_DIR-}"; then
+        for audio_nice10_file in launch.sh enter.sh nice.real i2s-loopback i2s-loopback.real aplay aplay.real arecord arecord.real; do
+            rm -f "$AUDIO_NICE10_DIR/$audio_nice10_file" || {
+                audio_nice10_step_rc=$?
+                if test "$audio_nice10_cleanup_rc" -eq 0; then audio_nice10_cleanup_rc=$audio_nice10_step_rc; fi
+            }
+        done
+        if rmdir "$AUDIO_NICE10_DIR"; then
+            AUDIO_NICE10_DIR=
+            printf 'AUDIO_NICE10_WRAPPERS_RESTORE=PASS\n'
+        else
+            audio_nice10_step_rc=$?
+            if test "$audio_nice10_cleanup_rc" -eq 0; then audio_nice10_cleanup_rc=$audio_nice10_step_rc; fi
+        fi
+    fi
+    if test "$audio_nice10_cleanup_rc" -ne 0; then
+        printf 'AUDIO_IRQ_OTHER_NICE10_RESTORE=FAIL rc=%s\n' "$audio_nice10_cleanup_rc"
+    else
+        printf 'AUDIO_IRQ_OTHER_NICE10_RESTORE=PASS\n'
+    fi
+    return "$audio_nice10_cleanup_rc"
+}
