+"""PFDI rollback with owned tasks and fake chrt; never set host scheduling."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+HELPER = Path(__file__).resolve().parents[1] / 'scripts/test/qbox_audio_diagnostics.sh'
+FAKE_CHRT = r'''
+import json, os, sys
+from pathlib import Path
+path = Path(os.environ['TEST_SCHED_STATE'])
+state = json.loads(path.read_text())
+args = sys.argv[1:]
+tid = args[-1]
+if tid not in state['tasks']:
+    sys.exit('refusing a task not owned by this test')
+task = state['tasks'][tid]
+if args == ['-p', tid]:
+    state['calls'].append({'op': 'get', 'tid': tid})
+    path.write_text(json.dumps(state))
+    if state.get('fail_read_tid') == tid:
+        sys.exit(1)
+    print(f"pid {tid}'s current scheduling policy: {task['policy']}")
+    print(f"pid {tid}'s current scheduling priority: {task['priority']}")
+elif len(args) == 4 and args[1] == '-p' and args[0] in ('-o', '-f', '-r'):
+    policy = {'-o': 'SCHED_OTHER', '-f': 'SCHED_FIFO', '-r': 'SCHED_RR'}[args[0]]
+    call = {'op': 'set', 'tid': tid, 'policy': policy, 'priority': int(args[2])}
+    failure = 'fail_demote_once_tid' if args[0] == '-o' else 'fail_restore_once_tid'
+    call['success'] = state.get(failure) != tid
+    state['calls'].append(call)
+    if call['success']:
+        task.update(policy=policy, priority=int(args[2]))
+    else:
+        state.pop(failure)
+    path.write_text(json.dumps(state))
+    sys.exit(0 if call['success'] else 1)
+else:
+    sys.exit('unexpected fake chrt syntax: ' + repr(args))
