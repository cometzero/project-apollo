--- /dev/null
+++ b/scripts/test/qbox_audio_experiment.py
@@ -0,0 +1,408 @@
+"""Optional evidence collection for the AP-only and full QBox audio verifiers."""
+
+import base64
+import binascii
+import hashlib
+import http.server
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tarfile
+import time
+
+from qbox_audio_health import assess_audio_guest_health
+
+ROOT = Path(__file__).resolve().parents[2]
+PROC = Path('/proc')
+IMPLEMENTATION_FILES = {
+    '.': ('scripts/test/qbox_audio_experiment.py', 'scripts/test/qbox_audio_diagnostics.sh',
+          'scripts/test/summarize_qbox_audio_trace.py', 'scripts/test/verify_qbox_linux_audio.py',
+          'scripts/test/verify_qbox_full_audio.py', 'scripts/test/verify_qbox_i2s.sh',
+          'scripts/test/verify_dma350_memory.sh', 'scripts/test/verify_qemu_i2s_wav.py',
+          'scripts/test/qbox_audio_uki.py', 'scripts/test/qbox_audio_repeat.py',
+          'scripts/test/qbox_audio_health.py'),
+    'hsoc-stack/tools/qemu': ('hw/dma/arm-dma350.c', 'hw/audio/dw-apb-i2s.c'),
+    'hsoc-stack/tools/qbox': ('qemu-components/common/include/ports/initiator.h',
+                            'qemu-components/common/include/ports/initiator-telemetry.h',
+                            'qemu-components/common/include/ports/qemu-initiator-signal-socket.h'),
+    'hsoc-stack/tools/qbox-platform': (
+        'platforms/apollo/apollo-qvp.lua', 'platforms/apollo/apollo-qvp-linux.lua',
+        'platforms/apollo/apollo-qvp-common.lua',
+        'qemu-components/qemu_dma350/include/qemu_dma350.h',
+        'qemu-components/qemu_dw_apb_i2s/include/qemu_dw_apb_i2s.h'),
+    'hsoc-stack/components/primary_compute/linux': ('drivers/dma/arm-dma350.c',
+                                                  'sound/soc/dwc/dwc-pcm.c'),
+    'hsoc-stack/yocto/meta-hsoc-auto-solutions': ('recipes-test/i2s-loopback/files/i2s_loopback.c',),
+}
+
+
+def source_provenance():
+    """Bind tracked changes and untracked implementation bytes separately."""
+    result = {}
+    for repository, names in IMPLEMENTATION_FILES.items():
+        directory = ROOT / repository
+        git = ['git', '-C', str(directory)]
+        diff = subprocess.check_output(git + ['diff', '--binary', 'HEAD', '--', *names])
+        result[repository] = {
+            'head': subprocess.check_output(git + ['rev-parse', 'HEAD'], text=True).strip(),
+            'tracked_diff_sha256': hashlib.sha256(diff).hexdigest(),
+            'tracked_diff_bytes': len(diff),
+            'files': {name: {'sha256': hashlib.sha256((directory / name).read_bytes()).hexdigest()}
+                      if (directory / name).is_file() else {'status': 'MISSING'} for name in names},
+        }
+    return result
+
+
+def add_arguments(parser):
+    parser.add_argument('--diagnostics', action='store_true',
+                        help='Collect bounded guest tracing and native model/bridge statistics')
+    parser.add_argument('--disable-cpu-idle', action='store_true',
+                        help='Diagnostic experiment: disable guest idle states during the suite')
+    parser.add_argument('--pfdi-normal-priority', action='store_true',
+                        help='Diagnostic experiment: run existing PFDI workers with SCHED_OTHER, then restore')
+    parser.add_argument('--chrt-binary', type=Path,
+                        help='Serve an explicit guest chrt binary for scheduling experiments')
+    parser.add_argument('--experiment-script', type=Path,
+                        help='Diagnostic shell defining audio_experiment_setup/cleanup; records its SHA256')
+    parser.add_argument('--pcm-binary', type=Path,
+                        help='Serve an explicit i2s-loopback binary without replacing the initrd')
+    parser.add_argument('--kprobes', type=Path,
+                        help='Explicit build-specific guest kprobe definitions (requires diagnostics)')
+
+
+def prepare(args, output, serve):
+    if args.kprobes and not args.diagnostics:
+        raise ValueError('--kprobes requires --diagnostics and matching kernel offsets')
+    pfdi_normal = getattr(args, 'pfdi_normal_priority', False)
+    custom = getattr(args, 'experiment_script', None)
+    if args.diagnostics or args.disable_cpu_idle or pfdi_normal or custom:
+        shutil.copyfile(ROOT / 'scripts/test/qbox_audio_diagnostics.sh', serve / 'diagnostics.sh')
+    for source, name in ((args.pcm_binary, 'i2s-loopback'), (args.kprobes, 'audio-kprobes.events'),
+                         (getattr(args, 'chrt_binary', None), 'chrt'), (custom, 'experiment.sh')):
+        if source:
+            shutil.copyfile(source, serve / name)
+    if args.kprobes:
+        # Validate precisely the snapshot later downloaded by the guest.
+        args.kprobes = (serve / 'audio-kprobes.events').absolute()
+    manifest = {
+        'schema_version': 1, 'host_time_ns': time.time_ns(),
+        'diagnostics': args.diagnostics, 'disable_cpu_idle': args.disable_cpu_idle,
+        'pfdi_normal_priority': pfdi_normal,
+        'experiment_script': str(custom) if custom else None,
+        'qualification': 'DIAGNOSTIC' if args.disable_cpu_idle or pfdi_normal or custom else 'baseline-settings',
+        'host_cpu_affinity': sorted(os.sched_getaffinity(0)),
+        'injected_files': {}, 'source_heads': {}, 'configuration_sha256': {},
+    }
+    for name in ('i2s-loopback', 'audio-kprobes.events', 'diagnostics.sh', 'chrt', 'experiment.sh'):
+        path = serve / name
+        if path.exists():
+            manifest['injected_files'][name] = hashlib.sha256(path.read_bytes()).hexdigest()
+    manifest['implementation'] = source_provenance()
+    manifest['source_heads'] = {name: value['head'] for name, value in manifest['implementation'].items()}
+    for name in ('local.conf', 'bblayers.conf', 'templateconf.cfg'):
+        path = ROOT / 'build/conf' / name
+        manifest['configuration_sha256'][name] = hashlib.sha256(path.read_bytes()).hexdigest()
+    (output / 'run-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+
+
+def augment_suite(suite, args, port):
+    """Wrap the existing suite, preserving its exit code and default behavior."""
+    setup = []
+    pfdi_normal = getattr(args, 'pfdi_normal_priority', False)
+    custom = getattr(args, 'experiment_script', None)
+    if args.pcm_binary:
+        setup += [f'wget -q -O /tmp/i2s-loopback http://10.0.2.2:{port}/i2s-loopback',
+                  'chmod 755 /tmp/i2s-loopback', 'export PATH=/tmp:$PATH',
+                  'sha256sum /tmp/i2s-loopback']
+    if getattr(args, 'chrt_binary', None):
+        setup += [f'wget -q -O /tmp/chrt http://10.0.2.2:{port}/chrt',
+                  'chmod 755 /tmp/chrt', 'export PATH=/tmp:$PATH', 'sha256sum /tmp/chrt']
+    if args.diagnostics or args.disable_cpu_idle or pfdi_normal or custom:
+        setup += [f'wget -q -O /tmp/audio-diagnostics.sh http://10.0.2.2:{port}/diagnostics.sh',
+                  '. /tmp/audio-diagnostics.sh',
+                  '''audio_custom_ready=0
+audio_custom_cleaned=0
+audio_custom_cleanup_once() {
+    if test "$audio_custom_ready" -eq 0 || test "$audio_custom_cleaned" -eq 1; then
+        return 0
+    fi
+    audio_custom_cleaned=1
+    audio_experiment_cleanup
+}
+audio_suite_exit_cleanup() {
+    audio_exit_status=$?
+    trap - EXIT HUP INT TERM
+    set +e
+    audio_custom_cleanup_once
+    audio_cleanup_status=$?
+    if test "$audio_exit_status" -eq 0; then audio_exit_status=$audio_cleanup_status; fi
+    audio_diag_cleanup
+    audio_cleanup_status=$?
+    if test "$audio_exit_status" -eq 0; then audio_exit_status=$audio_cleanup_status; fi
+    exit "$audio_exit_status"
+}''',
+                  "trap 'audio_suite_exit_cleanup' EXIT",
+                  "trap 'exit 130' INT", "trap 'exit 143' HUP TERM"]
+    if args.kprobes:
+        setup += [f'wget -q -O /tmp/audio-kprobes.events http://10.0.2.2:{port}/audio-kprobes.events']
+    if args.diagnostics:
+        setup += ['export I2S_LOOPBACK_DIAGNOSTICS=1',
+                  f'audio_diag_start http://10.0.2.2:{port}/diagnostics/__MODE__']
+    if args.disable_cpu_idle:
+        setup += ['audio_idle_disable']
+    if pfdi_normal:
+        setup += ['audio_pfdi_demote']
+    if custom:
+        setup += [f'wget -q -O /tmp/audio-experiment.sh http://10.0.2.2:{port}/experiment.sh',
+                  '. /tmp/audio-experiment.sh',
+                  'audio_custom_ready=1',
+                  'audio_experiment_setup']
+    if not setup:
+        return suite
+    # Keep explicit exits in --tests memory/wav inside the original subshell.
+    body = suite.removeprefix('#!/bin/sh\n')
+    finish = ['suite_rc=$?', 'set -e']
+    if args.disable_cpu_idle:
+        finish += ['audio_idle_restore']
+    if pfdi_normal:
+        finish += ['policy_rc=0', 'audio_pfdi_restore || policy_rc=$?',
+                   'if test "$suite_rc" -eq 0; then suite_rc=$policy_rc; fi']
+    if custom:
+        finish += ['experiment_rc=0', 'audio_custom_cleanup_once || experiment_rc=$?',
+                   'if test "$suite_rc" -eq 0; then suite_rc=$experiment_rc; fi']
+    if args.diagnostics:
+        finish += ['audio_diag_stop || echo AUDIO_DIAGNOSTICS_UPLOAD_FAILED=1']
+    finish += ['exit "$suite_rc"']
+    return ('#!/bin/sh\nset -eu\n' + '\n'.join(setup) +
+            '\nset +e\n(\ntrap - EXIT HUP INT TERM\n' + body +
+            ')\n' + '\n'.join(finish) + '\n')
+
+
+def environment(args, out):
+    env = dict(os.environ)
+    if args.diagnostics:
+        # The AP-only launcher owns creation of its output directory.
+        directory = out.parent / (out.name + '-initiator-telemetry')
+        directory.mkdir(parents=True, exist_ok=True)
+        env.update(QEMU_AUDIO_TELEMETRY='1', QBOX_INITIATOR_TELEMETRY_DIR=str(directory),
+                   QBOX_INITIATOR_TELEMETRY_FILTER='platform.ap_')
+    return env
+
+
+def validate_probe_kernel(args, kernel_sha256):
+    if not args.kprobes:
+        return
+    match = re.search(r'exact Image SHA256 ([0-9a-f]{64})', args.kprobes.read_text())
+    if not match or match[1] != kernel_sha256:
+        raise ValueError('Kprobe definitions do not match the selected kernel Image SHA256')
+
+
+def _process_tree():
+    processes = {}
+    for path in PROC.glob('[0-9]*/stat'):
+        try:
+            fields = path.read_text().rsplit(') ', 1)[1].split()
+            processes[int(path.parent.name)] = {'ppid': int(fields[1]), 'start_ticks': int(fields[19])}
+        except (OSError, ValueError, IndexError):
+            continue
+    return processes
+
+
+def _hash_loaded_file(path, mapped_path, expected=None):
+    result = {'mapped_path': mapped_path, 'resolved_path': str(Path(mapped_path).resolve())}
+    try:
+        if mapped_path.endswith(' (deleted)'):
+            raise ValueError('Mapped file was deleted; do not hash a replacement at its old path')
+        with path.open('rb') as stream:
+            before = os.fstat(stream.fileno())
+            if expected is not None:
+                device, inode = expected
+                major, minor = (int(value, 16) for value in device.split(':'))
+                if (before.st_ino, os.major(before.st_dev), os.minor(before.st_dev)) != (inode, major, minor):
+                    raise ValueError('Path inode/device differs from the running mapping')
+            digest = hashlib.sha256()
+            for chunk in iter(lambda: stream.read(1024 * 1024), b''):
+                digest.update(chunk)
+            after = os.fstat(stream.fileno())
+            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns):
+                raise ValueError('File changed during hashing')
+        result.update(status='COLLECTED', sha256=digest.hexdigest(), size=before.st_size,
+                      inode=before.st_ino, device=before.st_dev,
+                      identity='proc_exe' if expected is None else 'maps_inode_device_verified')
+    except (OSError, ValueError) as error:
+        result.update(status='NOT_COLLECTED', reason=str(error))
+    return result
+
+
+def capture_loaded_runtime(root_pid, out):
+    """Snapshot only the descendant simulator; call before starting traffic."""
+    manifest_path = out / 'loaded-runtime.json'
+    previous = None
+    if manifest_path.exists():
+        previous = json.loads(manifest_path.read_text())
+        if previous.get('status') == 'COLLECTED':
+            return previous
+    result = {'status': 'NOT_COLLECTED', 'root_pid': root_pid,
+              'host_time_ns': time.time_ns(), 'artifacts': []}
+    if previous is not None:
+        result['previous_failure'] = {key: previous[key] for key in ('host_time_ns', 'reason') if key in previous}
+    try:
+        processes = _process_tree()
+        descendants = {root_pid}
+        while True:
+            expanded = descendants | {pid for pid, data in processes.items() if data['ppid'] in descendants}
+            if expanded == descendants:
+                break
+            descendants = expanded
+        candidates = []
+        for pid in descendants:
+            try:
+                executable = os.readlink(PROC / str(pid) / 'exe')
+                if Path(executable.removesuffix(' (deleted)')).name == 'platforms-vp':
+                    candidates.append((pid, executable))
+            except OSError:
+                continue
+        # QBox forks a same-executable shared-memory cleanup service. Select
+        # the top-level simulator, while still rejecting separate sibling VPs.
+        candidate_ids = {pid for pid, _ in candidates}
+        def nested_candidate(pid):
+            visited = {pid}
+            parent = processes[pid]['ppid']
+            while parent in processes and parent not in visited:
+                if parent in candidate_ids:
+                    return True
+                visited.add(parent)
+                parent = processes[parent]['ppid']
+            return False
+        top_level = [(pid, executable) for pid, executable in candidates if not nested_candidate(pid)]
+        result['excluded_nested_simulator_pids'] = sorted(candidate_ids - {pid for pid, _ in top_level})
+        if len(top_level) != 1:
+            raise ValueError(f'Expected one top-level descendant platforms-vp; found {len(top_level)}')
+        pid, executable = top_level[0]
+        proc = PROC / str(pid)
+        start_ticks = processes[pid]['start_ticks']
+        maps = (proc / 'maps').read_text()
+        maps_path = out / 'loaded-runtime.maps'
+        maps_path.write_text(maps)
+        result.update(target_pid=pid, start_ticks=start_ticks, exe=executable,
+                      maps_file=str(maps_path), maps_sha256=hashlib.sha256(maps.encode()).hexdigest())
+        result['artifacts'].append(_hash_loaded_file(proc / 'exe', executable))
+        selected = {}
+        for line in maps.splitlines():
+            fields = line.split(maxsplit=5)
+            if len(fields) != 6 or not fields[5].startswith('/'):
+                continue
+            path = fields[5]
+            name = Path(path).name
+            relevant = ('/qbox/modules/' in path or name.startswith((
+                'libqemu-', 'libqbox', 'libsystemc', 'libgssync', 'libtlm')))
+            if relevant and '.so' in name:
+                selected[path] = (fields[3], int(fields[4]))
+        for path, identity in sorted(selected.items()):
+            result['artifacts'].append(_hash_loaded_file(Path(path), path, identity))
+        current = _process_tree().get(pid)
+        if current is None or current['start_ticks'] != start_ticks:
+            raise ValueError('Simulator exited or changed identity while collecting mappings')
+        loaded_names = {Path(item['mapped_path']).name for item in result['artifacts'] if item['status'] == 'COLLECTED'}
+        required = {'platforms-vp', 'qemu_dma350.so', 'qemu_dw_apb_i2s.so', 'libqemu-system-aarch64.so'}
+        missing = sorted(required - loaded_names)
+        if missing:
+            raise ValueError('Required runtime binaries not collected: ' + ', '.join(missing))
+        if any(item['status'] != 'COLLECTED' for item in result['artifacts']):
+            raise ValueError('Some selected mapped files could not be identified')
+        result['status'] = 'COLLECTED'
+    except (OSError, ValueError, KeyError) as error:
+        result['reason'] = str(error)
+    out.mkdir(parents=True, exist_ok=True)
+    manifest_path.write_text(json.dumps(result, indent=2) + '\n')
+    return result
+
+
+def validate_archive(path):
+    with tarfile.open(path, 'r:gz') as archive:
+        members = archive.getmembers()
+        if not members or len(members) > 2048 or sum(m.size for m in members) > 64 * 1024 * 1024:
+            raise ValueError('Diagnostic archive is empty or exceeds collection limits')
+
+
+class AudioHTTPHandler(http.server.SimpleHTTPRequestHandler):
+    """Receive only bounded diagnostic archives from this disposable guest."""
+
+    def do_POST(self):
+        match = re.fullmatch(r'/diagnostics/(dma|pio)(/base64)?', self.path)
+        if not match:
+            self.send_error(404)
+            return
+        try:
+            size = int(self.headers.get('Content-Length', '0'))
+        except ValueError:
+            size = 0
+        if not 0 < size <= 64 * 1024 * 1024:
+            self.send_error(413)
+            return
+        self.connection.settimeout(60)
+        mode = match[1]
+        directory = Path(self.directory).parent / mode
+        directory.mkdir(parents=True, exist_ok=True)
+        path = directory / 'guest-diagnostics.tar.gz'
+        temporary = path.with_suffix('.upload')
+        try:
+            with temporary.open('wb') as stream:
+                remaining = size
+                while remaining:
+                    chunk = self.rfile.read(min(remaining, 1024 * 1024))
+                    if not chunk:
+                        raise EOFError('Incomplete diagnostic upload')
+                    stream.write(chunk)
+                    remaining -= len(chunk)
+            if match[2]:
+                # BusyBox wget --post-file uses strlen and truncates binary
+                # gzip at its first NUL. The guest sends wrapped ASCII base64.
+                encoded = b''.join(temporary.read_bytes().split())
+                temporary.write_bytes(base64.b64decode(encoded, validate=True))
+            validate_archive(temporary)
+            temporary.replace(path)
+        except (OSError, EOFError, ValueError, binascii.Error, tarfile.TarError):
+            temporary.unlink(missing_ok=True)
+            self.send_error(400)
+            return
+        self.send_response(200)
+        self.send_header('Content-Length', '3')
+        self.end_headers()
+        self.wfile.write(b'OK\n')
+
+
+def annotate_result(result, text, args, out):
+    result['diagnostics_enabled'] = args.diagnostics
+    result['cpu_idle_disabled'] = args.disable_cpu_idle
+    result['pfdi_normal_priority'] = getattr(args, 'pfdi_normal_priority', False)
+    result['experiment_script'] = str(getattr(args, 'experiment_script', None) or '')
+    result['qualification'] = ('DIAGNOSTIC' if args.disable_cpu_idle or result['pfdi_normal_priority'] or result['experiment_script']
+                               else 'baseline-settings')
+    runtime = out / 'loaded-runtime.json'
+    result['loaded_runtime'] = json.loads(runtime.read_text()) if runtime.exists() else {
+        'status': 'NOT_COLLECTED', 'reason': 'No running simulator mapping snapshot'}
+    result['suite_exit_code'] = next((int(x) for x in re.findall(
+        r'^QBOX_AUDIO_DONE=(\d+)$', text, re.M)), None)
+    # aplay/arecord can recover and exit zero, so preserve XRUN as a failure.
+    result['xrun_messages'] = re.findall(r'^.*(?:underrun!!!|overrun!!!|Broken pipe).*$', text, re.M)
+    if result['xrun_messages']:
+        result['status'] = 'FAIL'
+    result['audio_status'] = result.get('status', 'NOT_ASSESSED')
+    result['guest_health'] = assess_audio_guest_health(text)
+    if result['guest_health']['status'] == 'FAIL':
+        result['status'] = 'FAIL'
+    if args.diagnostics:
+        archive = out / 'guest-diagnostics.tar.gz'
+        result['initiator_telemetry_directory'] = str(out.parent / (out.name + '-initiator-telemetry'))
+        result['diagnostic_archive'] = str(archive) if archive.exists() else None
+        try:
+            validate_archive(archive)
+            result['diagnostic_collection'] = 'COLLECTED'
+        except (OSError, EOFError, ValueError, tarfile.TarError) as error:
+            result['diagnostic_collection'] = 'NOT_COLLECTED'
+            result['diagnostic_error'] = str(error)
+    return result
