+@pytest.mark.parametrize('mutation', ['initrd', 'padding', 'kernel', 'source_kernel'])
+def test_validation_failure_is_atomic(uki, kernel, objcopy, monkeypatch, mutation):
+    original = uki.read_bytes()
+    run = helper.subprocess.run
+    monkeypatch.setattr(helper, '_objcopy', lambda: objcopy)
+
+    def mutate(command, **kwargs):
+        result = run(command, **kwargs)
+        output = Path(command[-1])
+        if mutation == 'source_kernel':
+            kernel.write_bytes(b'concurrent kernel change')
+        else:
+            metadata = helper.inspect_uki(output)
+            section = metadata['sections']['.linux' if mutation == 'kernel' else '.initrd']
+            offset = section['offset'] + (section['size'] if mutation == 'padding' else 0)
+            data = bytearray(output.read_bytes())
+            data[offset] ^= 1
+            output.write_bytes(data)
+        return result
+
+    monkeypatch.setattr(helper.subprocess, 'run', mutate)
+    with pytest.raises(ValueError, match='changed|differs'):
+        helper.replace_kernel(uki, kernel)
+    assert uki.read_bytes() == original
