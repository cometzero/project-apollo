+#!/bin/sh
+# P4 diagnostic: audio suite above IRQ-thread RT50, below PFDI app FIFO99.
+# No affinity, IRQ, PFDI, firmware, clock, buffer, or sample change.
+# This reproduced audio PASS with PFDI timeouts and RCU stalls; it is not a
+# qualified full-system configuration. Retained as a diagnostic control.
+audio_experiment_setup() {
+    audio_rt_pid=$$
+    audio_rt_changed=0
+    audio_rt_before=$(chrt -p "$audio_rt_pid") || return 1
+    printf '%s\n' "$audio_rt_before"
+    printf '%s\n' "$audio_rt_before" | grep -q 'policy: SCHED_OTHER$' || return 1
+    printf '%s\n' "$audio_rt_before" | grep -q 'priority: 0$' || return 1
+    chrt -r -p 60 "$audio_rt_pid" || return 1
+    audio_rt_changed=1
+    chrt -p "$audio_rt_pid" || return 1
+    echo AUDIO_EXPERIMENT=RR60_NO_AFFINITY_PFDI_UNCHANGED
+}
+audio_experiment_cleanup() {
+    if test "${audio_rt_changed:-0}" -eq 1; then
+        chrt -o -p 0 "$audio_rt_pid" || return 1
+        audio_rt_changed=0
+        audio_rt_after=$(chrt -p "$audio_rt_pid") || return 1
+        printf '%s\n' "$audio_rt_after"
+        printf '%s\n' "$audio_rt_after" | grep -q 'policy: SCHED_OTHER$' || return 1
+        printf '%s\n' "$audio_rt_after" | grep -q 'priority: 0$' || return 1
+        echo AUDIO_RR60_RESTORE=PASS
+    fi
+}
