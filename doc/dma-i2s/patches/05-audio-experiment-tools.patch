+"""Warm audio suite repetition and independent evidence assessment."""
+
+import argparse
+import base64
+import re
+import wave
+
+from verify_qemu_i2s import assess
+from verify_qemu_i2s_wav import digest, pcm
+
+
+def repeat_count(value):
+    try:
+        count = int(value)
+    except (TypeError, ValueError) as error:
+        raise argparse.ArgumentTypeError('repeat must be an integer from 1 to 100') from error
+    if not 1 <= count <= 100:
+        raise argparse.ArgumentTypeError('repeat must be an integer from 1 to 100')
+    return count
+
+
+def add_arguments(parser):
+    parser.add_argument('--repeat', type=repeat_count, default=1,
+                        help='Run the suite 1..100 times in the same boot (default: 1)')
+    parser.add_argument('--fail-fast', action='store_true',
+                        help='Stop repetitions after the first nonzero guest suite exit')
+
+
+def wrap_suite(suite, count, fail_fast=False):
+    count = repeat_count(count)
+    if count == 1:
+        return suite
+    body = suite.removeprefix('#!/bin/sh\n')
+    return f'''#!/bin/sh
+set +e
+audio_iteration=1
+audio_first_rc=0
+while test "$audio_iteration" -le {count}; do
+    printf 'QBOX_AUDIO_ITERATION_BEGIN=%s total={count}\\n' "$audio_iteration"
+    (
+        trap - EXIT HUP INT TERM
+{body.rstrip()}
+    )
+    audio_iteration_rc=$?
+    printf 'QBOX_AUDIO_ITERATION_END=%s rc=%s\\n' "$audio_iteration" "$audio_iteration_rc"
+    if test "$audio_iteration_rc" -ne 0; then
+        if test "$audio_first_rc" -eq 0; then audio_first_rc=$audio_iteration_rc; fi
+        if test {int(fail_fast)} -eq 1; then break; fi
+    fi
+    audio_iteration=$((audio_iteration + 1))
+done
+exit "$audio_first_rc"
+'''
+
+
+def split_iterations(text, count):
+    """Reject missing, reordered, nested, duplicated or malformed boundaries."""
+    text = text.replace('\r', '')
+    if count == 1 and 'QBOX_AUDIO_ITERATION_' not in text:
+        return [{'iteration': 1, 'text': text, 'exit_code': None}], []
+    slices, errors = [], []
+    active = None
+    def finish(item):
+        item['text'] = ''.join(item['text'])
+        slices.append(item)
+
+    for line in text.splitlines(keepends=True):
+        if not line.startswith('QBOX_AUDIO_ITERATION_'):
+            if active is not None:
+                active['text'].append(line)
+            continue
+        begin = re.fullmatch(r'QBOX_AUDIO_ITERATION_BEGIN=(\d+) total=(\d+)\n?', line)
+        end = re.fullmatch(r'QBOX_AUDIO_ITERATION_END=(\d+) rc=(\d+)\n?', line)
+        if begin:
+            index, total = map(int, begin.groups())
+            if active is not None:
+                errors.append(f'Iteration {active["iteration"]} has no END before BEGIN {index}')
+                finish(active)
+            if total != count or index != len(slices) + 1 or index > count:
+                errors.append(f'Unexpected iteration BEGIN {index} total={total}')
+            active = {'iteration': index, 'text': [], 'exit_code': None}
+        elif end:
+            index, rc = map(int, end.groups())
+            if active is None or active['iteration'] != index or rc > 255:
+                errors.append(f'Unexpected iteration END {index} rc={rc}')
+                continue
+            active['exit_code'] = rc
+            finish(active)
+            active = None
+        else:
+            errors.append(f'Malformed iteration marker: {line.rstrip()}')
+    if active is not None:
+        errors.append(f'Iteration {active["iteration"]} has no END')
+        finish(active)
+    if len(slices) != count:
+        errors.append(f'Expected {count} iterations, collected {len(slices)}')
+    return slices, errors
+
+
+def _single_zero(text, name):
+    return re.findall(rf'^{name}=(.*)$', text, re.M) == ['0']
+
+
+def assess_iteration(text, mode, tests, source, out):
+    """Keep the original PCM/byte comparison, scoped to exactly one run."""
+    memory_cases = re.findall(r'^DMA350_MEMORY_PASS base=(\w+) mode=(memcpy|memset)\b.*$', text, re.M)
+    expected = {(base, kind) for base in ('31000000', '31010000') for kind in ('memcpy', 'memset')}
+    memory_ok = (len(memory_cases) == 4 and set(memory_cases) == expected
+                 and _single_zero(text, 'DMA350_MEMORY_EXIT'))
+    memory = {'status': 'PASS' if memory_ok else 'FAIL', 'cases': memory_cases}
+    if tests not in ('all', 'memory'):
+        memory['status'] = 'SKIP'
+
+    pcm_result = {'status': 'SKIP'}
+    if tests in ('all', 'pcm'):
+        pcm_result = assess(text, mode)
+        markers_ok = (_single_zero(text, 'QEMU_I2S_DONE') and all(
+            len(re.findall(rf'^{marker}$', text, re.M)) == count
+            for marker, count in (('QEMU_I2S_IRQ_BEFORE', 1), ('QEMU_I2S_IRQ_AFTER', 1),
+                                  ('QEMU_I2S_IRQ_END', 2), (f'I2S_DRIVER_TEST_PASS mode={mode}', 1))))
+        if not markers_ok:
+            pcm_result['status'] = 'FAIL'
+            pcm_result['error'] = 'Missing or duplicated PCM completion/IRQ markers'
+
+    wav_results = []
+    wav_modes = re.findall(r'^WAV_MODE=(.*)$', text, re.M)
+    wav_mode_ok = tests not in ('all', 'wav') or wav_modes == [mode]
+    if tests in ('all', 'wav'):
+        source_params, source_pcm = pcm(source)
+        source_bytes = source.read_bytes()
+        for name in ('forward', 'reverse'):
+            result = {'direction': name, 'status': 'FAIL'}
+            pattern = rf'^WAV_DATA_BEGIN={name}\n(.*?)^WAV_DATA_END={name}$'
+            matches = re.findall(pattern, text, re.M | re.S)
+            boundaries_ok = all(len(re.findall(rf'^WAV_DATA_{edge}={name}$', text, re.M)) == 1
+                                for edge in ('BEGIN', 'END'))
+            if len(matches) == 1 and boundaries_ok:
+                try:
+                    path = out / f'{name}.wav'
+                    path.write_bytes(base64.b64decode(''.join(matches[0].split()), validate=True))
+                    params, data = pcm(path)
+                    same = params == source_params and data == source_pcm
+                    same_file = path.read_bytes() == source_bytes
+                    commands_ok = re.findall(rf'^WAV_EXIT={name} (.*)$', text, re.M) == ['playback=0 capture=0']
+                    result.update(status='PASS' if same and same_file and commands_ok and wav_mode_ok else 'FAIL',
+                                  frames=len(data) // 4, exact_pcm_match=same, exact_wav_match=same_file,
+                                  wav_sha256=digest(path), command_exit_success=commands_ok,
+                                  path=str(path))
+                except (ValueError, EOFError, wave.Error) as error:
+                    result['error'] = str(error)
+            else:
+                result['error'] = 'Missing, incomplete or duplicated WAV data block'
+            wav_results.append(result)
+
+    xrun = re.findall(r'^.*(?:underrun!!!|overrun!!!|Broken pipe).*$', text, re.M)
+    wav_done = tests not in ('all', 'wav') or _single_zero(text, 'WAV_DONE')
+    passed = (memory['status'] in ('PASS', 'SKIP') and pcm_result['status'] in ('PASS', 'SKIP')
+              and all(item['status'] == 'PASS' for item in wav_results)
+              and wav_mode_ok and wav_done and not xrun)
+    return {'status': 'PASS' if passed else 'FAIL', 'dma350_memory': memory,
+            'i2s_pcm': pcm_result, 'wav': wav_results, 'wav_completed': wav_done,
+            'wav_mode_confirmed': wav_mode_ok, 'wav_modes': wav_modes,
+            'xrun_messages': xrun}
+
+
+def assess_repetitions(text, mode, tests, source, out, count=1, fail_fast=False):
+    count = repeat_count(count)
+    text = text.replace('\r', '')
+    slices, errors = split_iterations(text, count)
+    iterations = []
+    done_codes = re.findall(r'^QBOX_AUDIO_DONE=(\d+)$', text, re.M)
+    done = done_codes == ['0']
+    for position, item in enumerate(slices, 1):
+        directory = out if count == 1 else out / f'iteration-{position:03d}'
+        directory.mkdir(parents=True, exist_ok=True)
+        result = assess_iteration(item['text'], mode, tests, source, directory)
+        rc = item['exit_code']
+        if count == 1 and 'QBOX_AUDIO_ITERATION_' not in text:
+            rc = int(done_codes[0]) if len(done_codes) == 1 else None
+        result.update(iteration=item['iteration'], exit_code=rc)
+        if rc != 0:
+            result['status'] = 'FAIL'
+        iterations.append(result)
+    passed = done and not errors and len(iterations) == count and all(
+        item['status'] == 'PASS' for item in iterations)
+    result = {'status': 'PASS' if passed else 'FAIL', 'repeat': count, 'fail_fast': fail_fast,
+              'iterations': iterations, 'iteration_errors': errors, 'guest_completed': done}
+    if count == 1 and len(iterations) == 1:
+        result.update({key: iterations[0][key] for key in ('dma350_memory', 'i2s_pcm', 'wav')})
+    else:
+        for key in ('dma350_memory', 'i2s_pcm'):
+            values = [item[key] for item in iterations]
+            status = 'FAIL'
+            if len(values) == count and all(item['status'] in ('PASS', 'SKIP') for item in values):
+                status = 'SKIP' if all(item['status'] == 'SKIP' for item in values) else 'PASS'
+            result[key] = {'status': status, 'iterations': values}
+        result['wav'] = [dict(wav, iteration=item['iteration'])
+                         for item in iterations for wav in item['wav']]
+    return result
