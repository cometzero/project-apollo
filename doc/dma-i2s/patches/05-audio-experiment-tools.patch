+@pytest.mark.parametrize('mode', ['dma', 'pio'])
+@pytest.mark.parametrize('encoding', ['binary', 'base64'])
+def test_real_http_post_keeps_archive_bytes_and_contents(upload_server, mode, encoding):
+    port, output = upload_server
+    payload = b'COLLECTED snd_pcm/xrun\n'
+    buffer = io.BytesIO()
+    with tarfile.open(fileobj=buffer, mode='w:gz') as archive:
+        member = tarfile.TarInfo('collection.log')
+        member.size = len(payload)
+        archive.addfile(member, io.BytesIO(payload))
+    data = buffer.getvalue()
+
+    endpoint = f'/diagnostics/{mode}'
+    body = data
+    if encoding == 'base64':
+        endpoint += '/base64'
+        body = base64.encodebytes(data)
+        assert b'\0' not in body  # BusyBox wget's strlen-based POST is safe.
+    assert post(port, endpoint, body) == (200, b'OK\n')
+    archive_path = output / mode / 'guest-diagnostics.tar.gz'
+    assert archive_path.read_bytes() == data
+    with tarfile.open(archive_path, mode='r:gz') as archive:
+        assert archive.getnames() == ['collection.log']
+        assert archive.extractfile('collection.log').read() == payload
+    assert not list(output.rglob('*.upload'))
+
