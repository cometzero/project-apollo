+@pytest.mark.parametrize('kind', ['authenticode', 'pcrsig'])
+def test_signed_images_rejected_without_modification(uki, kernel, kind):
+    data = bytearray(uki.read_bytes())
+    if kind == 'authenticode':
+        struct.pack_into('<II', data, 152 + 144, 1024, 32)
+    else:
+        data[392 + 4 * 40:392 + 4 * 40 + 8] = b'.pcrsig\0'
+    uki.write_bytes(data)
+    with pytest.raises(ValueError, match='[Ss]igned'):
+        helper.replace_kernel(uki, kernel)
+    assert uki.read_bytes() == data
+
