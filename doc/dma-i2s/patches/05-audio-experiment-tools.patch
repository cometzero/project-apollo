@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Summarize bounded native audio/bridge diagnostics without inferring DMI hits."""
+
+import argparse
+import json
+from pathlib import Path
+import re
+import tarfile
+
+from qbox_audio_experiment import validate_archive
+
+
+def fields(text):
+    record = {}
+    for key, value in re.findall(r'(\w+)=(\S+)', text):
+        try:
+            record[key] = int(value, 16 if value.startswith('0x') else 10)
+        except ValueError:
+            record[key] = value
+    return record
+
+
+def summarize(directory):
+    result = {'scope': 'observed counters and bridge fallbacks; not DMI hit rate',
+              'native': {}, 'bridge': {}, 'guest': {}}
+    for mode in ('dma', 'pio'):
+        out = directory / mode
+        log = next((p for p in (out/'qbox-platform.log', out/'qbox.log') if p.exists()), None)
+        if not log:
+            continue
+        devices, raw = {}, []
+        for line in log.read_text(errors='replace').splitlines():
+            marker = re.search(r'QEMU_AUDIO_(DMA|I2S|LIMIT)\s+(.*)', line)
+            if not marker:
+                continue
+            kind, payload = marker.groups()
+            record = fields(payload)
+            record['kind'] = kind
+            raw.append(record)
+            key = f"{kind}:{record.get('dev')}:{record.get('channel', '')}"
+            device = devices.setdefault(key, {'rows': 0, 'last': {}, 'active_frame_rates_hz': []})
+            device['rows'] += 1
+            prev = device['last']
+            if kind == 'I2S' and record.get('event') == prev.get('event') == 'frame-summary':
+                dt = record['virtual_ns'] - prev['virtual_ns']
+                frames = record['tx_frames'] - prev['tx_frames']
+                if dt > 0 and frames > 0:
+                    device['active_frame_rates_hz'].append(frames * 1e9 / dt)
+            device['last'] = record
+        for device in devices.values():
+            rates = device.pop('active_frame_rates_hz')
+            if rates:
+                device['sampled_frame_rate_hz'] = {'min': min(rates), 'max': max(rates),
+                                                  'median': sorted(rates)[len(rates)//2],
+                                                  'interval_count': len(rates)}
+        result['native'][mode] = devices
+        (out/'native-audio-events.jsonl').write_text(''.join(json.dumps(r)+'\n' for r in raw))
+        for path in sorted((directory/(mode+'-initiator-telemetry')).glob('*.jsonl')):
+            rows = []
+            for line in path.read_text().splitlines():
+                try:
+                    rows.append(json.loads(line))
+                except json.JSONDecodeError:
+                    # A forced termination can leave the final checkpoint incomplete.
+                    continue
+            checkpoints = [r for r in rows if r.get('type') == 'checkpoint']
+            metadata = next((r for r in rows if r.get('type') == 'metadata'), {})
+            result['bridge'][mode+':'+path.stem] = {
+                'metadata': metadata, 'checkpoint_count': len(checkpoints),
+                'last_checkpoint': checkpoints[-1] if checkpoints else None,
+                'mapping_events': [r for r in rows if r.get('type') == 'mapping'],
+            }
+        archive = out/'guest-diagnostics.tar.gz'
+        if archive.exists():
+            try:
+                validate_archive(archive)
+            except (OSError, EOFError, ValueError, tarfile.TarError) as error:
+                result['guest'][mode] = {'status': 'NOT_COLLECTED', 'error': str(error)}
+                continue
+            guest = {'archive': str(archive), 'files': [], 'first_xrun': None, 'wrap_events': []}
+            with tarfile.open(archive, 'r:gz') as tar:
+                for member in tar:
+                    guest['files'].append(member.name)
+                    if not member.isfile() or member.size > 64 * 1024 * 1024:
+                        continue
+                    if Path(member.name).name not in ('trace', 'trace.txt'):
+                        continue
+                    stream = tar.extractfile(member)
+                    for raw_line in stream:
+                        line = raw_line.decode(errors='replace').strip()
+                        if re.search(r'\b(?:audio_|alsa_)?xrun:', line) and guest['first_xrun'] is None:
+                            guest['first_xrun'] = line
+                        if re.search(r'\b(?:audio_|alsa_)?wrap:', line) and len(guest['wrap_events']) < 20:
+                            guest['wrap_events'].append(line)
+            result['guest'][mode] = guest
+            (out/'first-xrun.json').write_text(json.dumps(guest, indent=2)+'\n')
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--run-dir', required=True, type=Path)
+    args = parser.parse_args()
+    result = summarize(args.run_dir)
+    target = args.run_dir/'trace-summary.json'
+    target.write_text(json.dumps(result, indent=2)+'\n')
+    print(target)
+
+
+if __name__ == '__main__':
+    main()
