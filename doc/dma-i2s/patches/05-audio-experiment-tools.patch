+"""Repeat audio evidence must never borrow a PASS or WAV from another run."""
+
+import argparse
+import base64
+import importlib
+import os
+from pathlib import Path
+import subprocess
+import sys
+import wave
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/test'))
+import qbox_audio_repeat as repeat
+
+
+@pytest.fixture
+def source(tmp_path):
+    path = tmp_path / 'source.wav'
+    with wave.open(str(path), 'wb') as stream:
+        stream.setparams((2, 2, 48000, 8, 'NONE', 'not compressed'))
+        stream.writeframes(bytes(range(32)))
+    return path
+
+
+def evidence(source, mode='dma'):
+    lines = [f'DMA350_MEMORY_PASS base={base} mode={kind}'
+             for base in ('31000000', '31010000') for kind in ('memcpy', 'memset')]
+    lines += ['DMA350_MEMORY_EXIT=0', 'QEMU_I2S_IRQ_BEFORE',
+              ' 30: 0 0 0 0 GICv3 390 Level dma1chan0',
+              ' 31: 0 0 0 0 GICv3 388 Level 30200000.i2s',
+              ' 32: 0 0 0 0 GICv3 389 Level 30210000.i2s', 'QEMU_I2S_IRQ_END']
+    for _ in range(2):
+        for tx, rx in (('hw:0,0', 'hw:1,1'), ('hw:1,0', 'hw:0,1')):
+            lines += [f'I2S_LOOPBACK_PASS playback={tx} capture={rx} '
+                      'frames=65536 bytes=262144 format=S16_LE rate=48000 idle=16']
+    lines += [f'I2S_DRIVER_TEST_PASS mode={mode}', 'QEMU_I2S_IRQ_AFTER',
+              ' 30: 8 16 0 0 GICv3 390 Level dma1chan0',
+              ' 31: 8 8 0 0 GICv3 388 Level 30200000.i2s',
+              ' 32: 8 8 0 0 GICv3 389 Level 30210000.i2s',
+              'QEMU_I2S_IRQ_END', 'QEMU_I2S_DONE=0', f'WAV_MODE={mode}']
+    for name in ('forward', 'reverse'):
+        lines += [f'WAV_EXIT={name} playback=0 capture=0', f'WAV_DATA_BEGIN={name}',
+                  base64.b64encode(source.read_bytes()).decode(), f'WAV_DATA_END={name}']
+    return '\n'.join(lines + ['WAV_DONE=0', ''])
+
+
+def session(*bodies, codes=None, done=0):
+    codes = codes or [0] * len(bodies)
+    return ''.join(f'QBOX_AUDIO_ITERATION_BEGIN={index} total={len(bodies)}\n{body}'
+                   f'QBOX_AUDIO_ITERATION_END={index} rc={rc}\n'
+                   for index, (body, rc) in enumerate(zip(bodies, codes), 1)) + f'QBOX_AUDIO_DONE={done}\n'
+
+
+def assess(source, text, count=2, tests='all', mode='dma'):
+    return repeat.assess_repetitions(text, mode, tests, source, source.parent / 'out', count)
+
+
+@pytest.mark.parametrize('mode', ['dma', 'pio'])
+def test_every_iteration_has_four_pcm_and_two_exact_wav_results(source, mode):
+    result = assess(source, session(evidence(source, mode), evidence(source, mode)), mode=mode)
+    assert result['status'] == 'PASS'
+    assert [item['i2s_pcm']['pcm_pass_count'] for item in result['iterations']] == [4, 4]
+    assert [len(item['wav']) for item in result['iterations']] == [2, 2]
+    assert len(result['wav']) == 4
+    assert all(item['exact_pcm_match'] and item['exact_wav_match'] for item in result['wav'])
+    assert len({item['path'] for item in result['wav']}) == 4
+
+
+@pytest.mark.parametrize('position', [0, 1])
+@pytest.mark.parametrize('old,new', [
+    ('DMA350_MEMORY_PASS', 'DMA350_MEMORY_FAIL'),
+    ('DMA350_MEMORY_EXIT=0', 'DMA350_MEMORY_EXIT=37'),
+    ('I2S_LOOPBACK_PASS', 'I2S_LOOPBACK_FAIL'),
+    ('I2S_DRIVER_TEST_PASS mode=dma', 'I2S_DRIVER_TEST_PASS mode=pio'),
+    ('QEMU_I2S_DONE=0', 'QEMU_I2S_DONE=1'),
+    ('8 16 0 0', '0 0 0 0'),
+    ('WAV_EXIT=forward playback=0 capture=0', 'WAV_EXIT=forward playback=1 capture=0'),
+    ('WAV_DATA_BEGIN=forward', 'MISSING_DATA_BEGIN=forward'),
+    ('WAV_DATA_END=reverse', 'MISSING_DATA_END=reverse'),
+    ('WAV_DONE=0', 'WAV_DONE=124'),
+    ('WAV_DONE=0', ''),
+    ('WAV_DONE=0', 'overrun!!!\nWAV_DONE=0'),
+])
+def test_failure_in_any_iteration_cannot_use_other_iteration_pass(source, position, old, new):
+    bodies = [evidence(source), evidence(source)]
+    bodies[position] = bodies[position].replace(old, new, 1)
+    result = assess(source, session(*bodies))
+    assert result['status'] == 'FAIL'
+    assert result['iterations'][position]['status'] == 'FAIL'
+    assert result['iterations'][1 - position]['status'] == 'PASS'
+
+
+@pytest.mark.parametrize('payload', ['@@invalid@@', '', 'AAAA', 'UklGRg=='])
+def test_partial_or_invalid_base64_is_failure(source, payload):
+    body = evidence(source).replace(base64.b64encode(source.read_bytes()).decode(), payload, 1)
+    result = assess(source, session(evidence(source), body))
+    assert result['status'] == 'FAIL'
+    assert result['iterations'][1]['wav'][0]['status'] == 'FAIL'
+
+
+def test_valid_wav_with_different_pcm_is_failure(source):
+    data = bytearray(source.read_bytes())
+    data[-1] ^= 1
+    body = evidence(source).replace(base64.b64encode(source.read_bytes()).decode(),
+                                    base64.b64encode(data).decode(), 1)
+    result = assess(source, session(body, evidence(source)))
+    assert result['status'] == 'FAIL'
+    assert result['iterations'][0]['wav'][0]['exact_pcm_match'] is False
+
+
+@pytest.mark.parametrize('marker', [
+    'DMA350_MEMORY_PASS base=31000000 mode=memcpy', 'DMA350_MEMORY_EXIT=0',
+    'QEMU_I2S_DONE=0', 'QEMU_I2S_IRQ_BEFORE',
+    'WAV_EXIT=forward playback=0 capture=0', 'WAV_DATA_BEGIN=forward', 'WAV_DONE=0',
+])
+def test_duplicate_markers_do_not_hide_failed_or_partial_retries(source, marker):
+    body = evidence(source) + marker + '\n'
+    assert assess(source, session(body, evidence(source)))['status'] == 'FAIL'
+
+
+@pytest.mark.parametrize('old,new', [
+    ('QBOX_AUDIO_ITERATION_BEGIN=2 total=2', ''),
+    ('QBOX_AUDIO_ITERATION_END=2 rc=0', ''),
+    ('QBOX_AUDIO_ITERATION_END=1 rc=0', ''),
+    ('QBOX_AUDIO_ITERATION_BEGIN=2 total=2', 'QBOX_AUDIO_ITERATION_BEGIN=1 total=2'),
+    ('QBOX_AUDIO_ITERATION_BEGIN=2 total=2', 'QBOX_AUDIO_ITERATION_BEGIN=3 total=2'),
+    ('QBOX_AUDIO_ITERATION_BEGIN=2 total=2', 'QBOX_AUDIO_ITERATION_BEGIN=2 total=3'),
+    ('QBOX_AUDIO_ITERATION_END=1 rc=0', 'QBOX_AUDIO_ITERATION_END=2 rc=0'),
+    ('QBOX_AUDIO_ITERATION_END=2 rc=0', 'QBOX_AUDIO_ITERATION_END=2 rc=bad'),
+    ('QBOX_AUDIO_ITERATION_END=2 rc=0', 'QBOX_AUDIO_ITERATION_END=2 rc=256'),
+    ('QBOX_AUDIO_DONE=0', ''),
+    ('QBOX_AUDIO_DONE=0', 'QBOX_AUDIO_DONE=1'),
+    ('QBOX_AUDIO_DONE=0', 'QBOX_AUDIO_DONE=0\nQBOX_AUDIO_DONE=1'),
+])
+def test_missing_or_invalid_boundaries_and_outer_completion_fail(source, old, new):
+    text = session(evidence(source), evidence(source)).replace(old, new)
+    assert assess(source, text)['status'] == 'FAIL'
+
+
+def test_fail_fast_preserves_first_rc_and_rejects_unexecuted_iterations(source):
+    text = session(evidence(source), codes=[37], done=37).replace('total=1', 'total=3')
+    result = assess(source, text, count=3)
+    assert result['status'] == 'FAIL'
+    assert result['iterations'][0]['exit_code'] == 37
+    assert result['iteration_errors'] == ['Expected 3 iterations, collected 1']
+
+
+@pytest.mark.parametrize('tests', ['memory', 'pcm', 'wav'])
+def test_selected_workload_keeps_original_skip_policy(source, tests):
+    body = evidence(source)
+    if tests == 'memory':
+        body = body.split('QEMU_I2S_IRQ_BEFORE')[0]
+    elif tests == 'pcm':
+        body = body[body.index('QEMU_I2S_IRQ_BEFORE'):body.index('WAV_EXIT=')]
+    else:
+        body = body[body.index('WAV_MODE='):]
+    assert assess(source, session(body, body), tests=tests)['status'] == 'PASS'
+
+
+@pytest.mark.parametrize('tests', ['all', 'wav'])
+@pytest.mark.parametrize('mode', ['dma', 'pio'])
+@pytest.mark.parametrize('replacement', ['', 'WAV_MODE=wrong',
+                                         'WAV_MODE=dma\nWAV_MODE=pio'])
+def test_requested_wav_mode_must_be_reported_once(source, tests, mode, replacement):
+    body = evidence(source, mode)
+    if tests == 'wav':
+        body = body[body.index('WAV_MODE='):]
+    body = body.replace(f'WAV_MODE={mode}', replacement)
+    result = assess(source, session(body, evidence(source, mode)), tests=tests, mode=mode)
+    assert result['status'] == 'FAIL'
+    assert result['iterations'][0]['wav_mode_confirmed'] is False
+    assert all(item['status'] == 'FAIL' for item in result['iterations'][0]['wav'])
+    assert result['iterations'][1]['status'] == 'PASS'
+
+
+@pytest.mark.parametrize('requested,observed', [('pio', 'dma'), ('dma', 'pio')])
+def test_wav_only_cannot_qualify_opposite_driver_mode(source, requested, observed):
+    body = evidence(source, observed)
+    body = body[body.index('WAV_MODE='):]
+    result = assess(source, body + 'QBOX_AUDIO_DONE=0\n', count=1,
+                    tests='wav', mode=requested)
+    assert result['status'] == 'FAIL'
+    assert result['iterations'][0]['wav_modes'] == [observed]
+
+
+def test_default_one_keeps_script_and_wav_paths(source):
+    original = '#!/bin/sh\nset -eu\nexit 37\n'
+    assert repeat.wrap_suite(original, 1) == original
+    result = assess(source, evidence(source) + 'QBOX_AUDIO_DONE=0\n', count=1)
+    assert result['status'] == 'PASS'
+    assert result['i2s_pcm']['pcm_pass_count'] == 4
+    assert result['wav'][0]['path'] == str(source.parent / 'out/forward.wav')
+
+
+@pytest.mark.parametrize('value', ['0', '101', '-1', '1.5', 'bad'])
+def test_repeat_argument_rejects_out_of_range_values(value):
+    parser = argparse.ArgumentParser()
+    repeat.add_arguments(parser)
+    with pytest.raises(SystemExit):
+        parser.parse_args(['--repeat', value])
+
+
+@pytest.mark.parametrize('count', [1, 100])
+def test_repeat_argument_accepts_boundaries(count):
+    assert repeat.repeat_count(str(count)) == count
+
+
+@pytest.mark.parametrize('fail_fast', [False, True])
+@pytest.mark.parametrize('codes', [(0, 0, 0), (37, 0, 0), (0, 37, 81), (0, 0, 81)])
+def test_real_shell_repeats_same_suite_and_keeps_first_failure(tmp_path, fail_fast, codes):
+    body = '''#!/bin/sh
+set -eu
+number=0
+if test -f "$COUNTER"; then number=$(cat "$COUNTER"); fi
+number=$((number + 1))
+echo "$number" > "$COUNTER"
+echo original-suite-$number
+set -- $CODES
+shift "$((number - 1))"
+exit "$1"
+'''
+    script = repeat.wrap_suite(body, 3, fail_fast)
+    subprocess.run(['/bin/sh', '-n'], input=script, text=True, check=True)
+    result = subprocess.run(['/bin/sh'], input=script, text=True, capture_output=True,
+                            env={**os.environ, 'COUNTER': str(tmp_path / 'counter'),
+                                 'CODES': ' '.join(map(str, codes))}, timeout=5)
+    first_error = next((code for code in codes if code), 0)
+    expected_runs = codes.index(first_error) + 1 if fail_fast and first_error else len(codes)
+    assert result.returncode == first_error
+    assert (tmp_path / 'counter').read_text().strip() == str(expected_runs)
+    assert result.stdout.count('QBOX_AUDIO_ITERATION_BEGIN=') == expected_runs
+    slices, _ = repeat.split_iterations(result.stdout, 3)
+    assert [item['exit_code'] for item in slices] == list(codes[:expected_runs])
+
+
+@pytest.mark.parametrize('module_name', ['verify_qbox_full_audio', 'verify_qbox_linux_audio'])
+def test_both_launchers_accept_repeat_and_keep_existing_options(module_name):
+    module = importlib.import_module(module_name)
+    script = repeat.wrap_suite(module.guest_suite(1234), 3, True)
+    subprocess.run(['/bin/sh', '-n'], input=script, text=True, check=True)
+    help_text = subprocess.run([sys.executable, module.__file__, '--help'], check=True,
+                               capture_output=True, text=True, timeout=5).stdout
+    for option in ('--repeat', '--fail-fast', '--kernel', '--tests', '--kprobes'):
+        assert option in help_text
