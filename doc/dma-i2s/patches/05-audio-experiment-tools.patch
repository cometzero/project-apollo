+def test_growing_kernel_preserves_sections_and_source(uki, kernel, objcopy, tmp_path):
+    source = tmp_path / 'source.efi'
+    shutil.copyfile(uki, source)
+    original, kernel_original = source.read_bytes(), kernel.read_bytes()
+    uki.chmod(0o640)
+    result = helper.replace_kernel(uki, kernel)
+    before, after = result['before'], result['after']
+    assert result['kernel_sha256'] == hashlib.sha256(kernel_original).hexdigest()
+    assert after['kernel_sha256'] == result['kernel_sha256']
+    assert after['sections']['.linux']['size'] == len(kernel_original)
+    assert after['sections']['.linux']['rva'] >= max(
+        section['rva'] + max(section['size'], section['raw_size'])
+        for name, section in before['sections'].items() if name != '.linux')
+    assert set(result['preserved_sections']) == set(before['sections']) - {'.linux'}
+    for name, evidence in result['preserved_sections'].items():
+        section = after['sections'][name]
+        raw = uki.read_bytes()[section['offset']:section['offset'] + section['raw_size']]
+        assert evidence['raw_sha256'] == hashlib.sha256(raw).hexdigest()
+        assert section['sha256'] == before['sections'][name]['sha256']
+    assert not result['secure_boot']
+    assert source.read_bytes() == original
+    assert kernel.read_bytes() == kernel_original
+    assert uki.stat().st_mode & 0o777 == 0o640
+    assert not list(tmp_path.glob('.qbox-audio-uki-*'))
+
