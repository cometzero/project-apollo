     s->regs[0xfb4 / 4] = BIT(16) | s->triggers;
     s->regs[0xfc8 / 4] = 0x3a00043b;
+    /* Reset must drive every implemented IRQ low, including its first reset. */
+    for (c = 0; c < ARRAY_SIZE(s->irq_level); c++) {
+        s->irq_level[c] = -1;
+    }
     dma350_irq(s);
 }
 
