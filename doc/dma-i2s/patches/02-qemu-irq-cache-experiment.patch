+static void dma350_drive_irq(ARMDMA350State *s, unsigned output, bool level)
+{
+    if (s->telemetry) {
+        s->irq_evaluations++;
+    }
+    if (s->irq_level[output] == level) {
+        if (s->telemetry) {
+            s->irq_skipped++;
+        }
+        return;
+    }
+    s->irq_level[output] = level;
+    if (s->telemetry) {
+        s->irq_writes++;
+    }
+    qemu_set_irq(s->irq[output], level);
+}
+
 static void dma350_irq(ARMDMA350State *s)
 {
     uint32_t pending = 0;
     unsigned c;
     for (c = 0; c < s->channels; c++) {
         bool level = (REG(s, c, 4) & 0x7ff) != 0;
-        qemu_set_irq(s->irq[c], level);
+        dma350_drive_irq(s, c, level);
         pending |= level << c;
     }
     s->regs[0x200 / 4] = pending;
     s->regs[0x208 / 4] = !!(pending && (s->regs[0x20c / 4] & 1));
-    qemu_set_irq(s->irq[CHANNELS], s->regs[0x208 / 4]);
+    dma350_drive_irq(s, CHANNELS, s->regs[0x208 / 4]);
 }
 
