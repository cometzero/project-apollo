+static void i2s_drive_irq(DWAPBI2SState *s, bool level)
+{
+    if (s->telemetry) {
+        s->stats.irq_evaluations++;
+    }
+    if (s->irq_level == level) {
+        if (s->telemetry) {
+            s->stats.irq_skipped++;
+        }
+        return;
+    }
+    s->irq_level = level;
+    if (s->telemetry) {
+        s->stats.irq_writes++;
+    }
+    qemu_set_irq(s->irq, level);
+}
+
 static void drive_outputs(void *opaque)
 {
     DWAPBI2SState *s = opaque;
@@ -566,7 +589,7 @@ static void drive_outputs(void *opaque)
     if (s->global_enabled && s->tx_block_enabled && s->tx_channel_enabled) {
         enabled |= ISR_TXFE | ISR_TXFO;
     }
-    qemu_set_irq(s->irq, !!(interrupt_status(s) & enabled & ~s->imr));
+    i2s_drive_irq(s, !!(interrupt_status(s) & enabled & ~s->imr));
     request_update(&s->dma_tx, tx_active(s) &&
                    (s->dmacr & DMACR_TXBLOCK) && s->tx_fifo.count < FIFO_DEPTH,
                    force_tx);
@@ -689,7 +712,9 @@ static void i2s_reset(DeviceState *dev)
