new file mode 100644
index 0000000000000000000000000000000000000000..b8ed76066306ed6c2aac9d83b611c816cbe91687
--- /dev/null
+++ b/qemu-components/common/include/ports/initiator-telemetry.h
@@ -0,0 +1,222 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef QBOX_INITIATOR_TELEMETRY_H
+#define QBOX_INITIATOR_TELEMETRY_H
+
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+/* Optional observations of bridge misses, not a measurement of DMI hit rate.
+ * No SystemC/QEMU calls are made here. All times use the host steady clock.
+ * Storage is bounded; JSONL checkpoints survive a later process termination.
+ */
+class QemuInitiatorTelemetry
+{
+public:
+    enum Hint { UNHINTED, DMI_HINT, QEMU_MR_HINT, HINT_COUNT };
+    enum Event { DMI_GRANT, DMI_DENY, RAM_ALIAS_INSTALL, RAM_ALIAS_REMOVE,
+                 MMIO_ALIAS_INSTALL, INVALIDATE_REQUEST, EVENT_COUNT };
+    enum Path { DEBUG, REENTRANT, EXCLUSIVE, PATH_COUNT };
+
+private:
+    struct Histogram {
+        uint64_t count = 0, sum_ns = 0, max_ns = 0;
+        // <= 1us, 2us, ... 262144us, then overflow.
+        std::array<uint64_t, 20> buckets{};
+        void add(uint64_t ns)
+        {
+            ++count;
+            sum_ns += ns;
+            if (ns > max_ns) max_ns = ns;
+            unsigned bucket = 0;
+            while (bucket < buckets.size() - 1 && ns > (uint64_t(1000) << bucket)) ++bucket;
+            ++buckets[bucket];
+        }
+    };
+    struct Count { uint64_t count = 0, bytes = 0; };
+    struct Page {
+        uint64_t base = 0;
+        std::array<Count, HINT_COUNT> hints{};
+    };
+
+    FILE* m_file = nullptr;
+    std::mutex m_lock;
+    std::array<Count, HINT_COUNT> m_hints{};
+    std::array<uint64_t, EVENT_COUNT> m_events{};
+    std::array<uint64_t, PATH_COUNT> m_paths{};
+    std::array<Page, 128> m_pages{};
+    unsigned m_page_count = 0;
+    uint64_t m_page_overflow = 0, m_event_records = 0, m_reads = 0, m_writes = 0;
+    uint64_t m_next_checkpoint = 0;
+    Histogram m_transport, m_bql, m_total, m_recursive_wait;
+
+    static const char* hint_name(unsigned i)
+    {
+        static const char* names[] = {"unhinted", "dmi_hint", "qemu_mr_hint"};
+        return names[i];
+    }
+    static const char* event_name(unsigned i)
+    {
+        static const char* names[] = {"dmi_grant", "dmi_deny", "ram_alias_install",
+            "ram_alias_remove", "mmio_alias_install", "invalidate_request"};
+        return names[i];
+    }
+    static std::string json_string(const char* input)
+    {
+        std::string out = "\"";
+        for (const unsigned char* p = reinterpret_cast<const unsigned char*>(input); *p; ++p) {
+            if (*p == '"' || *p == '\\') out += '\\';
+            if (*p < 32) {
+                char escape[7];
+                std::snprintf(escape, sizeof(escape), "\\u%04x", *p);
+                out += escape;
+            } else {
+                out += static_cast<char>(*p);
+            }
+        }
+        return out + "\"";
+    }
+    void histogram(const char* name, const Histogram& h)
+    {
+        std::fprintf(m_file, ",\"%s\":{\"count\":%llu,\"sum_ns\":%llu,\"max_ns\":%llu,\"buckets\":[",
+            name, (unsigned long long)h.count, (unsigned long long)h.sum_ns, (unsigned long long)h.max_ns);
+        for (unsigned i = 0; i < h.buckets.size(); ++i)
+            std::fprintf(m_file, "%s%llu", i ? "," : "", (unsigned long long)h.buckets[i]);
+        std::fputs("]}", m_file);
+    }
+    void checkpoint_locked(const char* reason, uint64_t now)
+    {
+        std::fprintf(m_file, "{\"type\":\"checkpoint\",\"reason\":\"%s\",\"host_ns\":%llu,\"regular_reads\":%llu,\"regular_writes\":%llu,\"fallback\":{",
+            reason, (unsigned long long)now, (unsigned long long)m_reads, (unsigned long long)m_writes);
+        for (unsigned i = 0; i < HINT_COUNT; ++i)
+            std::fprintf(m_file, "%s\"%s\":{\"count\":%llu,\"bytes\":%llu}", i ? "," : "",
+                hint_name(i), (unsigned long long)m_hints[i].count, (unsigned long long)m_hints[i].bytes);
+        std::fputs("},\"events\":{", m_file);
+        for (unsigned i = 0; i < EVENT_COUNT; ++i)
+            std::fprintf(m_file, "%s\"%s\":%llu", i ? "," : "", event_name(i), (unsigned long long)m_events[i]);
+        std::fprintf(m_file, "},\"other_paths\":{\"debug\":%llu,\"reentrant\":%llu,\"exclusive\":%llu},\"event_records\":%llu,\"page_overflow_accesses\":%llu",
+            (unsigned long long)m_paths[DEBUG], (unsigned long long)m_paths[REENTRANT],
+            (unsigned long long)m_paths[EXCLUSIVE], (unsigned long long)m_event_records,
+            (unsigned long long)m_page_overflow);
+        histogram("transport", m_transport);
+        histogram("bql_reacquire", m_bql);
+        histogram("regular_total", m_total);
+        histogram("recursive_wait", m_recursive_wait);
+        std::fputs(",\"pages\":[", m_file);
+        for (unsigned p = 0; p < m_page_count; ++p) {
+            std::fprintf(m_file, "%s{\"base\":\"0x%llx\",\"hints\":{", p ? "," : "", (unsigned long long)m_pages[p].base);
+            for (unsigned i = 0; i < HINT_COUNT; ++i)
+                std::fprintf(m_file, "%s\"%s\":{\"count\":%llu,\"bytes\":%llu}", i ? "," : "", hint_name(i),
+                    (unsigned long long)m_pages[p].hints[i].count, (unsigned long long)m_pages[p].hints[i].bytes);
+            std::fputs("}}", m_file);
+        }
+        std::fputs("]}\n", m_file);
+        std::fflush(m_file);
+        m_next_checkpoint = now + 1000000000ULL;
+    }
+    void maybe_checkpoint_locked(uint64_t now)
+    {
+        if (now >= m_next_checkpoint) checkpoint_locked("interval", now);
+    }
+
+public:
+    QemuInitiatorTelemetry() = default;
+    QemuInitiatorTelemetry(const QemuInitiatorTelemetry&) = delete;
+    QemuInitiatorTelemetry& operator=(const QemuInitiatorTelemetry&) = delete;
+    ~QemuInitiatorTelemetry()
+    {
+        if (m_file) {
+            checkpoint("destructor");
+            std::fclose(m_file);
+        }
+    }
+    bool enabled() const { return m_file != nullptr; }
+    static uint64_t now_ns()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void init(const char* socket, const char* instance, const char* root_kind)
+    {
+        const char* directory = std::getenv("QBOX_INITIATOR_TELEMETRY_DIR");
+        const char* filter = std::getenv("QBOX_INITIATOR_TELEMETRY_FILTER");
+        if (!directory || !*directory || (filter && *filter && !std::strstr(socket, filter))) return;
+        std::string filename(socket);
+        for (char& c : filename)
+            if (!(c == '.' || c == '_' || c == '-' || (c >= '0' && c <= '9') ||
+                  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) c = '_';
+        filename = std::string(directory) + "/" + filename + ".jsonl";
+        m_file = std::fopen(filename.c_str(), "w");
+        if (!m_file) {
+            std::fprintf(stderr, "QBox initiator telemetry: cannot open %s\n", filename.c_str());
+            return;
+        }
+        std::fprintf(m_file, "{\"type\":\"metadata\",\"schema\":1,\"socket\":%s,\"instance\":%s,\"root_kind\":%s,\"clock\":\"host_steady_ns\",\"histogram_first_upper_ns\":1000,\"histogram_multiplier\":2,\"histogram_last_bucket\":\"overflow\",\"page_bytes\":65536,\"page_limit\":128,\"event_record_limit\":256,\"note\":\"fallback and alias observations; not DMI hit rate\"}\n",
+            json_string(socket).c_str(), json_string(instance).c_str(), json_string(root_kind).c_str());
+        checkpoint_locked("init", now_ns());
+    }
+    void regular(uint64_t address, uint64_t bytes, bool write, Hint hint,
+                 uint64_t transport_ns, uint64_t bql_ns, uint64_t total_ns)
+    {
+        if (!enabled()) return;
+        std::lock_guard<std::mutex> lock(m_lock);
+        ++(write ? m_writes : m_reads);
+        ++m_hints[hint].count;
+        m_hints[hint].bytes += bytes;
+        const uint64_t page = address & ~uint64_t(0xffff);
+        unsigned p = 0;
+        for (; p < m_page_count && m_pages[p].base != page; ++p) {}
+        if (p == m_page_count && p < m_pages.size()) {
+            m_pages[p].base = page;
+            ++m_page_count;
+        }
+        if (p < m_pages.size()) {
+            ++m_pages[p].hints[hint].count;
+            m_pages[p].hints[hint].bytes += bytes;
+        } else ++m_page_overflow;
+        m_transport.add(transport_ns);
+        m_bql.add(bql_ns);
+        m_total.add(total_ns);
+        maybe_checkpoint_locked(now_ns());
+    }
+    void event(Event event, uint64_t start, uint64_t end, unsigned permissions = 0)
+    {
+        if (!enabled()) return;
+        std::lock_guard<std::mutex> lock(m_lock);
+        ++m_events[event];
+        const auto now = now_ns();
+        if (m_event_records < 256) {
+            ++m_event_records;
+            std::fprintf(m_file, "{\"type\":\"mapping\",\"event\":\"%s\",\"host_ns\":%llu,\"start\":\"0x%llx\",\"end\":\"0x%llx\",\"permissions\":%u}\n",
+                event_name(event), (unsigned long long)now, (unsigned long long)start, (unsigned long long)end, permissions);
+            std::fflush(m_file);
+        }
+        maybe_checkpoint_locked(now);
+    }
+    void other_path(Path path)
+    {
+        if (!enabled()) return;
+        std::lock_guard<std::mutex> lock(m_lock);
+        ++m_paths[path];
+        maybe_checkpoint_locked(now_ns());
+    }
+    void recursive_wait(uint64_t duration_ns)
+    {
+        if (!enabled()) return;
+        std::lock_guard<std::mutex> lock(m_lock);
+        m_recursive_wait.add(duration_ns);
+    }
+    void checkpoint(const char* reason)
+    {
+        if (!enabled()) return;
+        std::lock_guard<std::mutex> lock(m_lock);
+        checkpoint_locked(reason, now_ns());
+    }
+};
+
+#endif
