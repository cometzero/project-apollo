diff --git a/tests/qbox/test_initiator_telemetry.py b/tests/qbox/test_initiator_telemetry.py
new file mode 100644
index 0000000000000000000000000000000000000000..e4c79d809a86d34e8363d26c1bf1b8ce6d85bd14
--- /dev/null
+++ b/tests/qbox/test_initiator_telemetry.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Standalone C++14 checks for opt-in bridge telemetry (no simulator build)."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+HARNESS = r'''
+#include "ports/initiator-telemetry.h"
+#include <thread>
+#include <vector>
+int main() {
+    QemuInitiatorTelemetry t;
+    t.init("platform.ap_cpu_0.mem", "platform.ap_qemu_inst", "cpu_memory");
+    std::vector<std::thread> threads;
+    for (int n = 0; n < 4; ++n) threads.emplace_back([&t, n] {
+        for (int i = 0; i < 1000; ++i)
+            t.regular(0x80000000 + n * 65536, 4, n & 1,
+                      QemuInitiatorTelemetry::DMI_HINT, 1000, 2000, 4000);
+    });
+    for (auto& thread : threads) thread.join();
+    for (int i = 0; i < 300; ++i)
+        t.event(QemuInitiatorTelemetry::RAM_ALIAS_INSTALL, i * 65536, i * 65536 + 65535);
+    for (int i = 0; i < 200; ++i)
+        t.regular(uint64_t(i) * 65536, 2, true,
+                  QemuInitiatorTelemetry::QEMU_MR_HINT, 1500, 3000, 6000);
+    t.other_path(QemuInitiatorTelemetry::DEBUG);
+    t.recursive_wait(10000);
+    t.checkpoint("test");
+}
+'''
+
+
+class InitiatorTelemetryTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory = tempfile.TemporaryDirectory(prefix="qbox-initiator-telemetry-")
+        cls.base = Path(cls.directory.name)
+        source = cls.base / "telemetry.cc"
+        source.write_text(HARNESS)
+        cls.binary = cls.base / "telemetry"
+        subprocess.run(["g++", "-std=c++14", "-Wall", "-Wextra", "-Werror", "-pthread",
+                        "-I", str(ROOT / "qemu-components/common/include"),
+                        str(source), "-o", str(cls.binary)], check=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.directory.cleanup()
+
+    def run_harness(self, name, enabled=True, filter_value=None):
+        output = self.base / name
+        output.mkdir()
+        env = {k: v for k, v in os.environ.items() if not k.startswith("QBOX_INITIATOR_TELEMETRY_")}
+        if enabled:
+            env["QBOX_INITIATOR_TELEMETRY_DIR"] = str(output)
+        if filter_value:
+            env["QBOX_INITIATOR_TELEMETRY_FILTER"] = filter_value
+        subprocess.run([str(self.binary)], env=env, check=True, timeout=20)
+        return list(output.glob("*.jsonl"))
+
+    def test_disabled_and_filtered_leave_no_files(self):
+        self.assertEqual(self.run_harness("disabled", enabled=False), [])
+        self.assertEqual(self.run_harness("filtered", filter_value="global_initiator"), [])
+
+    def test_concurrent_counts_histograms_and_bounds(self):
+        files = self.run_harness("enabled", filter_value="platform.ap_")
+        self.assertEqual(len(files), 1)
+        records = [json.loads(line) for line in files[0].read_text().splitlines()]
+        self.assertEqual(records[0]["root_kind"], "cpu_memory")
+        self.assertEqual(records[0]["socket"], "platform.ap_cpu_0.mem")
+        self.assertEqual(sum(r["type"] == "mapping" for r in records), 256)
+        snapshot = next(r for r in records if r.get("reason") == "test")
+        self.assertEqual(snapshot["events"]["ram_alias_install"], 300)
+        self.assertEqual(snapshot["fallback"]["dmi_hint"], {"count": 4000, "bytes": 16000})
+        self.assertEqual(snapshot["fallback"]["qemu_mr_hint"], {"count": 200, "bytes": 400})
+        self.assertEqual(snapshot["regular_reads"], 2000)
+        self.assertEqual(snapshot["regular_writes"], 2200)
+        self.assertEqual(snapshot["transport"]["count"], 4200)
+        self.assertEqual(snapshot["transport"]["buckets"][:2], [4000, 200])
+        self.assertEqual(snapshot["transport"]["max_ns"], 1500)
+        self.assertEqual(snapshot["recursive_wait"]["sum_ns"], 10000)
+        self.assertEqual(snapshot["other_paths"]["debug"], 1)
+        self.assertEqual(len(snapshot["pages"]), 128)
+        self.assertEqual(snapshot["page_overflow_accesses"], 76)
+        self.assertEqual(records[-1]["reason"], "destructor")
+
+
+if __name__ == "__main__":
+    unittest.main()
