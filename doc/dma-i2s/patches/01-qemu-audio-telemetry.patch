+static void dma350_telemetry_log(ARMDMA350State *s, unsigned c,
+                               const char *event)
+{
+    DMA350Telemetry *t = &s->stats[c];
+
+    if (!s->telemetry || s->telemetry_rows > TELEMETRY_LOG_LIMIT) {
+        return;
+    }
+    if (s->telemetry_rows++ == TELEMETRY_LOG_LIMIT) {
+        fprintf(stderr, "QEMU_AUDIO_LIMIT model=dma350 dev=%s object=%p "
+                "limit=%u\n", s->telemetry_path, (void *)s,
+                TELEMETRY_LOG_LIMIT);
+        return;
+    }
+    fprintf(stderr, "QEMU_AUDIO_DMA dev=%s object=%p event=%s channel=%u "
+            "host_ns=%" PRId64 " virtual_ns=%" PRId64
+            " commands=%" PRIu64 " done=%" PRIu64 " beats=%" PRIu64
+            " read_bytes=%" PRIu64 " write_bytes=%" PRIu64
+            " rearms=%" PRIu64 " rearm_host_ns=%" PRId64
+            " rearm_virtual_ns=%" PRId64 " rearm_sum_ns=%" PRIu64
+            " rearm_max_ns=%" PRIu64 " done_host_ns=%" PRId64
+            " done_virtual_ns=%" PRId64 " done_pending=%d"
+            " cmd=0x%x status=0x%x xsize=0x%x xsizehi=0x%x\n",
+            s->telemetry_path, (void *)s, event, c,
+            qemu_clock_get_ns(QEMU_CLOCK_REALTIME),
+            qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+            t->commands, t->done, t->beats, t->read_bytes, t->write_bytes,
+            t->rearms, t->rearm_host_ns, t->rearm_virtual_ns,
+            t->rearm_sum_ns, t->rearm_max_ns,
+            t->done_host_ns, t->done_virtual_ns, t->done_pending,
+            REG(s, c, 0), REG(s, c, 4), REG(s, c, 0x20), REG(s, c, 0x24));
+}
+
+static void dma350_telemetry_start(ARMDMA350State *s, unsigned c)
+{
+    DMA350Telemetry *t = &s->stats[c];
+
+    if (!s->telemetry) {
+        return;
+    }
+    t->commands++;
+    if (t->done_pending) {
+        t->rearm_host_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) -
+                           t->done_host_ns;
+        t->rearm_virtual_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) -
+                              t->done_virtual_ns;
+        t->rearms++;
+        t->rearm_sum_ns += t->rearm_host_ns;
+        t->rearm_max_ns = MAX(t->rearm_max_ns, (uint64_t)t->rearm_host_ns);
+        t->done_pending = false;
+    }
+}
