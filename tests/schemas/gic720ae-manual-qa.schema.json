{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format_version", "verdict", "reason", "qualification_sha", "reviewer_receipt_sha"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "verdict": {"enum": ["APPROVE", "REJECT"]},
    "reason": {"type": "string"},
    "qualification_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_receipt_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
