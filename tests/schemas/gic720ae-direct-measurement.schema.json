{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format_version", "run_id", "command_registry_sha", "leaves"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "command_registry_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "leaves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "value", "digest"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["file_sha256", "git_object", "git_head", "git_index", "command_replay"]},
          "value": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "command_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "exit_code": {"type": "integer"}
        }
      }
    }
  }
}
