{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "operations"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["op", "module_role", "args"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "insmod"},
              "module_role": {"const": "gic720ae_test"},
              "args": {
                "type": "object",
                "required": ["target_cpu"],
                "additionalProperties": false,
                "properties": {
                  "target_cpu": {"enum": ["0", "1", "2", "3"]}
                }
              }
            }
          },
          {
            "oneOf": [
              {
                "type": "object",
                "required": ["op", "path", "value"],
                "additionalProperties": false,
                "properties": {
                  "op": {"const": "write"},
                  "path": {"const": "/sys/kernel/debug/gic720ae_test/control"},
                  "value": {
                    "enum": ["ipi 1\n", "spi 1\n", "snapshot\n"]
                  }
                }
              },
              {
                "type": "object",
                "required": ["op", "path", "value"],
                "additionalProperties": false,
                "properties": {
                  "op": {"const": "write"},
                  "path": {"const": "/sys/devices/system/cpu/cpu1/online"},
                  "value": {"enum": ["0\n", "1\n"]}
                }
              }
            ]
          },
          {
            "type": "object",
            "required": ["op", "path"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "read"},
              "path": {"const": "/proc/interrupts"}
            }
          },
          {
            "type": "object",
            "required": ["op", "module"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "rmmod"},
              "module": {"const": "gic720ae_test"}
            }
          }
        ]
      }
    }
  }
}
