{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm.example/schemas/apollo-qbox-pcie-irq-spi.schema.json",
  "title": "Apollo QBox isolated virtio-mmio SPI evidence",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reason",
    "input_sha256",
    "source_log_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pass", "fail"]},
    "reason": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_log_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "endpoint": {"type": "object", "additionalProperties": {"type": "string"}},
    "pci_vector": {"type": "object", "additionalProperties": {"type": "string"}},
    "spi_virq": {"type": "integer", "minimum": 1},
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": {"type": "string"}}
    },
    "spi_before": {"$ref": "#/$defs/counts"},
    "spi_after": {"$ref": "#/$defs/counts"},
    "spi_delta": {"$ref": "#/$defs/deltas"},
    "pci_vector_before": {"$ref": "#/$defs/counts"},
    "pci_vector_after": {"$ref": "#/$defs/counts"},
    "pci_vector_delta": {"$ref": "#/$defs/deltas"},
    "cleanup": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "counts": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "integer", "minimum": 0}
    },
    "deltas": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "integer"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {
        "properties": {"reason": {"const": "ok"}},
        "required": [
          "endpoint",
          "pci_vector",
          "spi_virq",
          "chain",
          "spi_before",
          "spi_after",
          "spi_delta",
          "pci_vector_before",
          "pci_vector_after",
          "pci_vector_delta",
          "cleanup"
        ]
      }
    }
  ],
  "additionalProperties": false
}
