{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm.example/schemas/apollo-pcie-its-runtime.schema.json",
  "title": "Apollo endpoint-bound IRQ runtime evidence",
  "type": "object",
  "required": ["schema_version", "status", "reason", "platform", "mode", "input_sha256", "input_sha256_valid", "source_log_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pass", "fail"]},
    "reason": {"type": "string", "minLength": 1},
    "platform": {"enum": ["fvp", "qbox", "invalid"]},
    "mode": {"enum": ["msix", "intx", "spi", "invalid"]},
    "action": {"enum": ["disk-io", "net-io", "control"]},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256_valid": {"type": "boolean"},
    "source_log_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "endpoint": {
      "type": "object",
      "required": ["event", "bdf", "vendor", "class", "driver", "devpath", "target", "mac"],
      "additionalProperties": {"type": "string"}
    },
    "virq": {"type": "integer", "minimum": 1},
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event", "virq", "index", "domain", "hwirq", "chip"],
        "additionalProperties": {"type": "string"}
      }
    },
    "cpu_count": {"type": "integer", "minimum": 2},
    "phases": {
      "type": "object",
      "required": ["cpu0", "cpu1", "offline", "replay"],
      "additionalProperties": {
        "type": "object",
        "required": ["before", "after", "delta", "effective_cpu"],
        "properties": {
          "before": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
          "after": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
          "delta": {"type": "array", "minItems": 2, "items": {"type": "integer"}},
          "effective_cpu": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "cleanup": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {
        "properties": {"reason": {"const": "ok"}, "input_sha256_valid": {"const": true}},
        "required": ["action", "endpoint", "virq", "chain", "cpu_count", "phases", "cleanup"]
      }
    }
  ],
  "additionalProperties": false
}
