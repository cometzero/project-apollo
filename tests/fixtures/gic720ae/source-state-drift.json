      "sha256": "e8660703f64dfb92b1933cb69858989becdcc86349a7d0330beea0501b5d546e",
      "value": "#\n# SPDX-License-Identifier: MIT\n#\n\nBBLAYERS ?= \" \\\n    /build/arm/arm-auto-solutions/layers/poky/../../arm-zena-css/yocto/meta-zena-css-bsp \\\n    /build/arm/arm-auto-solutions/layers/poky/../../arm-zena-css/yocto/meta-zena-css-safety-island \\\n    /build/arm/arm-auto-solutions/layers/poky/../../hsoc-stack/yocto/meta-hsoc-auto-solutions \\\n    /build/arm/arm-auto-solutions/layers/poky/../../hsoc-stack/yocto/meta-hsoc-bsp \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-arm/meta-arm \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-arm/meta-arm-toolchain \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-bluechi/meta-bluechi \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-cassini/meta-cassini-distro \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-clang \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-ewaol \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-openembedded/meta-filesystems \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-openembedded/meta-networking \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-openembedded/meta-oe \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-openembedded/meta-perl \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-openembedded/meta-python \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-ptx \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-secure-core/meta-efi-secure-boot \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-secure-core/meta-integrity \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-secure-core/meta-secure-core-common \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-secure-core/meta-signing-key \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-security \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-security/meta-parsec \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-virtualization \\\n    /build/arm/arm-auto-solutions/layers/poky/../meta-zephyr/meta-zephyr-core \\\n    /build/arm/arm-auto-solutions/layers/poky/meta \\\n    /build/arm/arm-auto-solutions/layers/poky/meta-poky \\\n    /build/arm/arm-auto-solutions/layers/poky/../../sw-ref-stack/yocto/meta-arm-auto-solutions \\\n\"\nBBPATH ?= \"${TOPDIR}\"\nBBFILES ??= \"\"\n"
    },
    "local.conf": {
      "bytes": 1640,
      "path": "build/conf/local.conf",
      "sha256": "6e64568b9cc6bbac5e381d3a8f0f53877a3ee6d371d4a23f0cfdf40f19cbac8e",
      "value": "#\n# SPDX-License-Identifier: MIT\n#\n\n# Apollo QVP build configuration for a traditional TEMPLATECONF workflow.\nRD_ASPEN_VARIANT = \"cfg2\"\nMACHINE ??= \"apollo-qvp\"\nPC_CPUS_COUNT_DEFAULT ??= \"4\"\nARM_FVP_EULA_ACCEPT = \"1\"\n\n# Keep the traditional TEMPLATECONF build aligned with the kas baremetal\n# environment. The demos image autoloads pfdi_misc, so firmware-side PFDI\n# support must be enabled too.\nPFDI_SUPPORT = \"1\"\nPFDI_MONITOR_SUPPORT = \"1\"\n\n# baremetal\nTMPDIR = \"${TOPDIR}/tmp_baremetal\"\nEXTRA_IMAGE_FEATURES:append = \" baremetal\"\n\n# base\nEXTRA_IMAGE_FEATURES:append = \" allow-empty-password allow-root-login \\\n  empty-root-password post-install-logging ssh-server-openssh\"\nCORE_IMAGE_EXTRA_INSTALL:append = \" ssh-pregen-hostkeys\"\nLICENSE_FLAGS_ACCEPTED:append = \" \\\n  ${@oe.utils.vartrue('ARM_FVP_EULA_ACCEPT', 'Arm-FVP-EULA', '', d)}\"\nIMAGE_CLASSES += \"testimage\"\n\n# build-capsule\nBUILD_UEFI_CAPSULE = \"1\"\n\n# cassini\nCASSINI_GENERIC_ARM64_FILESYSTEM = \"0\"\nDISTRO_FEATURES:remove = \"cassini-security cassini-ota cassini-parsec\"\nDISTRO_FEATURES:append = \" cassini-dev zephyr\"\nKERNEL_CLASSES:remove = \"containers_kernelcfg_check\"\n\n# cassini-base\nCONF_VERSION = \"2\"\nPACKAGECONFIG:remove:pn-qemu-system-native = \"gtk+ sdl\"\n\n# cassini-modsign\nDISTRO_FEATURES:append = \" modsign\"\n\n# demos\nEXTRA_IMAGE_FEATURES:append = \" demos\"\n\n# diskmon\nBB_DISKMON_DIRS = \"\\\n  STOPTASKS,${TMPDIR},1G,100K \\\n  STOPTASKS,${DL_DIR},1G,100K \\\n  STOPTASKS,${SSTATE_DIR},1G,100K \\\n  STOPTASKS,/tmp,100M,100K \\\n  HALT,${TMPDIR},100M,1K \\\n  HALT,${DL_DIR},100M,1K \\\n  HALT,${SSTATE_DIR},100M,1K \\\n  HALT,/tmp,10M,1K\"\n\nDISTRO ??= \"auto-ad-nexios\"\nBBMULTICONFIG ?= \"\"\n"
    },
