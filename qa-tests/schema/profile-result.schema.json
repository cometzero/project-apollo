{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm-auto-solutions.example/schema/profile-result.schema.json",
  "title": "Apollo validation profile result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile_id", "backend", "verdict", "expected", "assertions"],
  "properties": {
    "version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "backend": {"enum": ["fvp", "qbox"]},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "expected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "coverage_kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]},
        "coverage_kind": {"enum": ["identical", "semantic"]}
      }
    }
  }
}
