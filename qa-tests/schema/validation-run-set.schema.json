{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm-auto-solutions.example/schema/validation-run-set.schema.json",
  "title": "Apollo validation run set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "matrix_sha256", "results"],
  "properties": {
    "version": {"const": 1},
    "matrix_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile_result"}
    }
  },
  "$defs": {
    "profile_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile_id", "backend", "verdict", "expected", "assertions"],
      "properties": {
        "version": {"const": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "backend": {"enum": ["fvp", "qbox"]},
        "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "expected": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "coverage_kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]},
        "coverage_kind": {"enum": ["identical", "semantic"]}
      }
    }
  }
}
