menuconfig PFDI_MGMT
	bool "Platform Fault Detection Subsystem (manager)"
	default y
	depends on PFDI_MODULE
	depends on (!SMP || SCHED_CPU_MASK)

if PFDI_MGMT

config PFDI_MGMT_INIT_PRIORITY
	int "PFDI mgmt init priority"
	default 40
	range 0 99
	help
	  SYS_INIT priority for the PFDI manager.

config PFDI_MGMT_PERIOD_MS
	int "Periodic run interval (ms)"
	default 60
	range 1 60000

config PFDI_MGMT_THREAD_STACK_SIZE
	int "Per-CPU thread stack size"
	default 2048
	range 512 8192

config PFDI_MGMT_LOG_LEVEL
	int "PFDI mgmt log level"
	default 3
	range 0 4
	help
	  0=Off
	  1=Error
	  2=Warn
	  3=Info,
	  4=Debug

config PFDI_MGMT_DEBUG
	bool "Enable PFDI management debug features"
	default n
	help
	  Enables additional debug/testing functionality for the PFDI
	  management layer.

config PFDI_USE_ARM_FW_LIB
	bool "Using Arm firmware library"
	default n
	help
	  Enable this option when the build integrates the Arm-provided
	  firmware library.

config PFDI_FW_METADATA
	hex "PFDI firmware metadata (packed 64-bit word)"
	help
	  Packed firmware metadata word.
	  Bit layout (low 32 bits used):
		[31:24]  Vendor ID      (8 bits)
		[23:20]  Reserved       (must be 0)
		[19:16]  Implementation (4 bits)
		[15:8]   Major version  (8 bits)
		[7:0]    Minor version  (8 bits)

	  Upper 32 bits must be 0.
	  Vendor ID 0x01 is RESERVED for Arm and must not be used by
	  external vendors.

config PFDI_MGMT_SHELL
	bool "Enable Platform Fault Detection Interface shell Utils"
	default y
	depends on SHELL
endif
