menuconfig PFDI_MODULE
	bool "Platform Fault Detection (PFDI) support"
	default n
	help
	  Enable support for the Platform Fault Detection Interface (PFDI).

if PFDI_MODULE

config PFDI_OOR_ENABLE
	bool "Enable PFDI Out-of-Reset Test"
	default y
	help
	  When enabled, the PFDI Out-of-Reset test is executed on each CPU,
	  including both primary and secondary CPUs, during out-of-reset.

	  The availability of this option depends on the integrated firmware
	  library.

config PFDI_FAILSAFE_RETURN
	bool "Return on failure instead of stopping"
	default y
	help
	  When enabled, the failsafe path returns a failure status to the
	  caller instead of stopping execution.

	  Availability of this option depends on the integrated firmware
	  library.

config PFDI_ONL_EVENT_TRIGGERED
	bool "Enable Online Event-Triggered (OLE) mode"
	default n
	help
	  In Online Event-Triggered (OLE) mode, PFDI runs periodically
	  without blocking higher-priority applications or events for an
	  extended duration.

	  Availability of this option depends on the integrated firmware
	  library.

config PFDI_NUM_ITER
	int "Number of iterations per execution"
	default 0
	range 0 255
	help
	  Specifies the number of iterations executed each time PFDI
	  is invoked.

	  If set to 0, all remaining iterations for all tests are
	  executed before returning.

config PFDI_INIT_PRIORITY
	int "PFDI initialization priority"
	default KERNEL_INIT_PRIORITY_DEFAULT
	help
	  Initialization priority for the PFDI provider device.

config PLAT_PFDI_POST_RUN_HOOK
	bool "Enable platform-specific post-run hook"
	default n
	help
	  Execute a platform-specific hook after each PFDI run.

	  A custom platform hook, pfdi_post_run_hook(), is executed at
	  the end of pfdi_run(). Enabling this option requires the
	  platform to provide pfdi_post_run_hook()

endif
