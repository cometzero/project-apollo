{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Apollo QBox: host",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/local-apollo-qvp/work/qbox-platform/platforms-vp",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "miDebuggerServerAddress": "127.0.0.1:12339",
      "launchCompleteCommand": "exec-continue",
      "setupCommands": [
        {
          "description": "Load QBox and libqemu symbols",
          "text": "source ${workspaceFolder}/build/local-apollo-qvp/debug/gdb/qbox-host.gdb"
        }
      ],
      "sourceFileMap": {
        "/build/arm/arm-auto-solutions": "${workspaceFolder}"
      }
    },
    {
      "name": "Apollo QBox: host run",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/local-apollo-qvp/work/qbox-platform/platforms-vp",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "miDebuggerServerAddress": "127.0.0.1:12339",
      "launchCompleteCommand": "exec-continue",
      "setupCommands": [
        {
          "description": "Load QBox and libqemu symbols",
          "text": "source ${workspaceFolder}/build/local-apollo-qvp/debug/gdb/qbox-host.gdb"
        },
        {
          "description": "Let QBox create the domain GDB servers",
          "text": "delete breakpoints"
        }
      ],
      "sourceFileMap": {
        "/build/arm/arm-auto-solutions": "${workspaceFolder}"
      }
    },
    {
      "name": "Apollo QBox: RSE",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/local-apollo-qvp/work/trusted-firmware-m/bin/bl1_1.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "miDebuggerServerAddress": "127.0.0.1:12340",
      "launchCompleteCommand": "None",
      "setupCommands": [
        {
          "description": "Load all staged RSE firmware symbols",
          "text": "source ${workspaceFolder}/build/local-apollo-qvp/debug/gdb/domain-rse.gdb"
        }
      ],
      "sourceFileMap": {
        "/build/arm/arm-auto-solutions": "${workspaceFolder}"
      },
      "preLaunchTask": "Apollo QBox: wait for AP safe point"
    },
